#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Beryllium browser test suite.

Runs the installed Beryllium against local test pages and media, in
throwaway profiles (your own profile is never used), and writes a report.

  freebsd/tests/browser/run                 all offline tests
  freebsd/tests/browser/run --network       also the live-site tests (YouTube)
  freebsd/tests/browser/run --lockdown      with the renderer lockdown on
  freebsd/tests/browser/run media pages     only some groups (test file names)
  freebsd/tests/browser/run --list          list the tests
  freebsd/tests/browser/run --lockdown --repeat 100
                                            a hundred runs, one after another
  freebsd/tests/browser/run --tally         how many clean lockdown runs in a
                                            row, from the ledger of every run

Windows open while it runs unless you pass --headless (tests that inspect
the browser's own toolbar need a window and are skipped headless).
"""

import argparse
import json
import os
import subprocess
import sys
import time
import unittest

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

from berytest import capsicum, context, runner, soak  # noqa: E402

# Set for the runs a --repeat makes, so that each makes one run and no more.
REPEAT_CHILD = "BERYTEST_REPEAT_CHILD"

LOCKDOWN_SWITCH = "--enable-features=BerylliumCapsicumRenderer"


def add_lockdown(browser_args):
    """Switch the lockdown feature on in a list of browser switches. The
    browser reads one --enable-features switch, the last, so the feature
    joins one that is already there."""
    feature = LOCKDOWN_SWITCH.split("=", 1)[1]
    for i, arg in enumerate(browser_args):
        if arg.startswith("--enable-features="):
            browser_args[i] = f"{arg},{feature}"
            return
    browser_args.append(LOCKDOWN_SWITCH)


def start_lines(o, proc_debug=None):
    """What a run says before its first test, so a run made without the
    switch it was meant to have is seen at once and not in the report.
    proc_debug: the value of security.bsd.unprivileged_proc_debug, or None
    where there is no such sysctl."""
    lines = [f"Results: {o.results}"]
    if capsicum.lockdown_requested(o):
        lines.append("Renderer lockdown: requested (the sandbox tests are a gate)")
        if proc_debug == "0":
            lines.append("  security.bsd.unprivileged_proc_debug is 0: the gate cannot read the "
                         "renderers and will fail; set it to 1 for this run "
                         "(sudo sysctl security.bsd.unprivileged_proc_debug=1)")
    else:
        lines.append("Renderer lockdown: not requested (add --lockdown for a lockdown run)")
    if o.browser_args:
        lines.append("Browser switches: " + " ".join(o.browser_args))
    return lines


def proc_debug_setting():
    try:
        out = subprocess.run(["sysctl", "-n", "security.bsd.unprivileged_proc_debug"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def options(argv):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("\n\n", 1)[1])
    ap.add_argument("groups", nargs="*",
                    help="groups to run: startup pages media rendering fonts sandbox privacy ui "
                         "youtube stability (default: all)")
    ap.add_argument("--browser", help="browser binary (default: /usr/local/bin/beryllium)")
    ap.add_argument("--browser-arg", dest="browser_args", action="append", default=[],
                    help="extra browser switch, may repeat")
    ap.add_argument("--lockdown", action="store_true",
                    help="run with the renderer lockdown switched on: the same as "
                         "--browser-arg=--enable-features=BerylliumCapsicumRenderer; the "
                         "sandbox tests are then a gate and fail instead of skipping")
    ap.add_argument("--scheme", default="chrome",
                    help="scheme for opening internal pages over DevTools (default chrome: "
                         "Beryllium shows beryllium:// but maps it to chrome:// only in "
                         "the browser's own navigation, which DevTools' Page.navigate "
                         "bypasses; the startup test checks beryllium:// separately)")
    ap.add_argument("--headless", action="store_true", help="no windows")
    ap.add_argument("--network", action="store_true",
                    help="also run tests that need the internet (YouTube)")
    ap.add_argument("--youtube-video", default="aqz-KE-bpKQ",
                    help="video id for the YouTube test (default: Big Buck Bunny)")
    ap.add_argument("--watch", type=int, default=60,
                    help="seconds to watch live playback (default 60)")
    ap.add_argument("--idle", type=int, default=30,
                    help="seconds the privacy test watches an idle browser (default 30)")
    ap.add_argument("--results", help="results directory (default: ~/beryllium-test-results/<time>)")
    ap.add_argument("--keep-profiles", action="store_true",
                    help="keep the throwaway profiles for inspection")
    ap.add_argument("--cores", action="store_true",
                    help="let crashing processes write core dumps (runs the browser binary "
                         "directly, not the launcher) and add lldb backtraces to the report")
    ap.add_argument("--diagnose", action="store_true",
                    help="also run the diagnostic groups: videodiag (video playback under "
                         "different switches) and capsicum (what each process does that "
                         "Capsicum capability mode would refuse, traced with ktrace)")
    ap.add_argument("--my-settings", nargs="?", const="~/.config/beryllium", default=None,
                    metavar="DIR",
                    help="ui group: also check the toolbar with a copy of your own settings "
                         "(Local State and Default/Preferences from DIR, default "
                         "~/.config/beryllium; copied into a throwaway profile, your profile "
                         "is not opened)")
    ap.add_argument("--list", action="store_true", help="list the tests and exit")
    ap.add_argument("--repeat", type=int, metavar="N", default=0,
                    help="make N runs, one after another, each in its own directory under "
                         "the results directory")
    ap.add_argument("--tally", action="store_true",
                    help="say how many whole-suite lockdown runs in a row were clean, per "
                         "package version, from the ledger, and exit")
    ap.add_argument("--ledger", default=soak.default_ledger(),
                    help="the file every run adds one line to (default: %(default)s)")
    o = ap.parse_args(argv)
    if o.repeat < 0:
        ap.error("--repeat needs a number of runs")
    if os.environ.get(REPEAT_CHILD):
        o.repeat = 0
    if o.lockdown and not capsicum.lockdown_requested(o):
        add_lockdown(o.browser_args)
    if not o.results:
        o.results = os.path.join(os.path.expanduser("~"), "beryllium-test-results",
                                 time.strftime("%Y%m%d-%H%M%S"))
    return o


def load(groups):
    loader = unittest.TestLoader()
    suite = loader.discover(os.path.join(HERE, "tests"), pattern="test_*.py",
                            top_level_dir=HERE)
    if not groups:
        return suite
    wanted = unittest.TestSuite()

    def visit(s):
        for t in s:
            if isinstance(t, unittest.TestSuite):
                visit(t)
            elif group_of(t) in groups:
                wanted.addTest(t)
    visit(suite)
    return wanted


def group_of(test):
    """tests.test_30_media.Media.test_x -> media"""
    module = test.id().split(".")[1]
    return module.split("_", 2)[-1]


def tests_of(suite):
    for t in suite:
        if isinstance(t, unittest.TestSuite):
            yield from tests_of(t)
        else:
            yield t


def record(o):
    """Add this run's line to the ledger. A ledger that cannot be written
    is said and does not change the run's result."""
    try:
        with open(os.path.join(o.results, "report.json")) as f:
            report = json.load(f)
        soak.append(o.ledger, soak.entry_from_report(report, soak.boot_time(), o.results))
    except (OSError, ValueError) as e:
        print(f"This run was not added to the ledger ({o.ledger}): {e}")


def repeat_lines(o):
    lines = [f"Repeat: {o.repeat} runs, one after another, under {o.results}",
             f"Ledger: {o.ledger}"]
    if not capsicum.lockdown_requested(o) or o.groups:
        lines.append("These runs are recorded and do not count toward the bar for turning "
                     "the lockdown on by default: that takes --lockdown and no group names")
    return lines


def repeat_runs(o, argv):
    """Make o.repeat runs of this same command line, each a process of its
    own, so that a run that hangs or dies does not end the night."""
    print("\n".join(repeat_lines(o)))
    env = dict(os.environ, **{REPEAT_CHILD: "1"})
    package = runner.system_info()["beryllium_package"]

    def launch(results):
        command = [sys.executable, os.path.abspath(__file__), *argv,
                   "--results", results, "--ledger", o.ledger]
        return soak.run_once(lambda: subprocess.Popen(command, env=env,
                                                      start_new_session=True))

    def describe(outcome, started, seconds, results):
        return soak.entry_without_report(
            outcome, started, seconds, soak.boot_time(), package,
            capsicum.lockdown_requested(o), not o.groups, o.headless, results)

    status = soak.repeat(o.repeat, o.results, o.ledger, launch, describe)
    print("\n".join(soak.tally_lines(soak.read(o.ledger))))
    return status


def main(argv=None):
    argv = list(argv if argv is not None else sys.argv[1:])
    o = options(argv)
    if o.tally:
        print("\n".join(soak.tally_lines(soak.read(o.ledger))))
        return 0
    suite = load(o.groups)
    if o.list:
        for t in tests_of(suite):
            doc = (t.shortDescription() or "").strip()
            print(f"{t.id()}" + (f"\n    {doc}" if doc else ""))
        return 0
    if o.repeat:
        return repeat_runs(o, argv)
    context.CTX = ctx = context.Context(o)
    print("\n".join(start_lines(o, proc_debug_setting())))
    try:
        status = runner.run(ctx, suite)
    finally:
        ctx.close()
    record(o)
    return status


if __name__ == "__main__":
    sys.exit(main())
