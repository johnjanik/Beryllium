"""Stage 1 (binary pruning) for a tree that is not Helium's own tarball.

Helium's pruning.list is generated against Helium's prepared tarball.
Beryllium builds from Google's official -lite tarball, which lacks some of
those files, and Helium's prune_binaries.py exits with an error when a
listed file is missing. A file that is absent needs no pruning, so this
writes the list of entries that exist, reports how many were absent, and
runs Helium's prune_binaries.py on the filtered list.

  prune-existing <helium-utils-dir> <tree> <pruning.list> <out-list>
"""

import os
import subprocess
import sys


def main(argv):
    if len(argv) != 5:
        sys.exit(__doc__)
    utils, tree, plist, out = argv[1:]
    with open(plist, encoding="utf-8") as f:
        entries = [l.strip() for l in f if l.strip()]
    present = [e for e in entries if os.path.lexists(os.path.join(tree, e))]
    with open(out, "w", encoding="utf-8") as f:
        f.write("\n".join(present) + "\n")
    print(f"prune-existing: {len(present)} of {len(entries)} listed files present; "
          f"{len(entries) - len(present)} absent from this tarball")
    return subprocess.call([sys.executable, os.path.join(utils, "prune_binaries.py"),
                            "--keep-build-dependencies", tree, out])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
