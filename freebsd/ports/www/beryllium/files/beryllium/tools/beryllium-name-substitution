#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Beryllium's name substitution step (plan/05 stage 6).

Runs Helium's helium/utils/name_substitution.py unchanged, with Beryllium's
replacement rules swapped in. It runs after Helium's own pass
(Chrome -> Helium) and after i18n_apply.py (Helium's translations, whose
fingerprints assume Helium's text), so it is a pure rename of Helium's
result: user-visible "Helium" (and any remaining "Chrome"/"Chromium")
becomes "Beryllium", and "helium://" (or "chrome://") becomes
"beryllium://", in .grd/.grdp strings and their .xtb translations, with
the translation fingerprints recomputed the same way Helium does. It then
renames "Helium" in the C++ string literals that are shown to users (flag
names and descriptions, the services change notice), which are not .grd
messages.

Matches patches/branding/beryllium-webui-scheme.patch, which makes the
display scheme "beryllium" (decision Q11, 1 November 2026). Internal
identifiers (helium.services.* preference names, component ids) are not in
.grd strings and are not touched.

Usage (same arguments as Helium's script):
  beryllium-name-substitution --sub -t <chromium tree> [--backup-path x.tar.gz]
"""

import multiprocessing
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
# Repository layout by default; the port sets HELIUM_UTILS to the extracted
# Helium distfile.
HELIUM_UTILS = os.environ.get(
    "HELIUM_UTILS", os.path.join(HERE, "..", "..", "helium", "utils"))

BERYLLIUM_REGEXES_STR = [
    # Names that must not change (same exceptions as Helium's).
    (r'(\w+) Root Program', r'\1_unreplace Root Program'),
    (r'(\w+) Web( S|s)tore', r'\1_unreplace Web Store'),
    (r'(\w+) Remote Desktop', r'\1_unreplace Remote Desktop'),

    # Schemes: both Chromium's and Helium's display scheme.
    (r'(\b)(?:chrome|helium)://', r'\1beryllium://'),

    # Product names.
    (r'(?:Google )?Chrom(e|ium)(?!\w)', r'Beryllium'),
    (r'(?<!\w)Helium(?!\w)', r'Beryllium'),

    # Cleanup.
    (r'((?:Google )?Chrom(e|ium))_unreplace', r'\1'),
    (r'_unreplace', r''),
]

SANITY = [
    ('chrome://about', 'beryllium://about'),
    ('helium://setup', 'beryllium://setup'),
    ('Chrome Root Program', 'Chrome Root Program'),
    (' Chrome  ', ' Beryllium  '),
    ('Chrome Web Store', 'Chrome Web Store'),
    ('Chromium Web Store', 'Chromium Web Store'),
    ('Chrome Remote Desktop', 'Chrome Remote Desktop'),
    ('Google Chrome', 'Beryllium'),
    ('Chrome Google Chrome Chrome Chromium', 'Beryllium Beryllium Beryllium Beryllium'),
    ('Chromium', 'Beryllium'),
    ('Helium', 'Beryllium'),
    ('Helium services', 'Beryllium services'),
    ('Heliumlike', 'Heliumlike'),
]


XML_DECLARATION_RE = re.compile(r"^<\?xml[^>]*\?>\s*")


def install(util):
    """Swap Beryllium's rules into Helium's utility module.

    Also makes a rewritten .grd/.grdp keep or omit the XML declaration
    exactly as the original did. Helium's replace_grit_tree always writes
    one; Helium's own pass never rewrites files that contain only "Helium"
    (such as components/helium_onboarding/helium_onboarding_strings.grdp),
    but this pass does, and the onboarding generator (generate-i18n.mts)
    requires <grit-part> to be the first node. Without this, the build
    fails with "expected <grit-part> root element" (2 November 2026).
    """
    util.REPLACEMENT_REGEXES_STR = BERYLLIUM_REGEXES_STR
    util.REPLACEMENT_REGEXES = [(re.compile(a), b) for a, b in BERYLLIUM_REGEXES_STR]
    original = getattr(util, "_beryllium_original_replace_grit_tree",
                       util.replace_grit_tree)
    util._beryllium_original_replace_grit_tree = original

    def replace_grit_tree(text):
        out, fp_map = original(text)
        if not text.lstrip().startswith("<?xml"):
            out = XML_DECLARATION_RE.sub("", out, count=1)
        return out, fp_map

    util.replace_grit_tree = replace_grit_tree


def sanity(util):
    for source, expected in SANITY:
        modified, match = util.replace_text(source)
        if source == expected:
            assert modified == expected, f"sanity: {source!r} became {modified!r}"
            continue
        assert match, f"sanity: {source!r} should match"
        assert modified == expected, f"sanity: {modified!r} != {expected!r}"


# User-visible text that Helium keeps in C++ string literals, which the .grd
# rename above does not reach: flag names and descriptions on the flags page
# (the browser test suite found "Helium flag." and "Controls whether Helium
# asks..." on beryllium://flags, 4 November 2026), and the services change
# notice. Only the capitalised word "Helium" inside double-quoted literals is
# renamed; lowercase flag ids (stored in the user's profile) and identifiers
# such as kHeliumFoo are left alone.
CPP_STRING_FILES = (
    os.path.join("chrome", "browser", "helium_flag_entries.h"),
    os.path.join("components", "helium_services", "schema.cc"),
)
FLAG_ENTRIES = CPP_STRING_FILES[0]
CPP_STRING_RE = re.compile(r'"(?:[^"\\\n]|\\.)*"')
HELIUM_WORD_RE = re.compile(r"\bHelium\b")


def rename_in_string_literals(text):
    """Returns (text, count) with "Helium" renamed inside string literals."""
    count = 0

    def literal(m):
        nonlocal count
        new, n = HELIUM_WORD_RE.subn("Beryllium", m.group(0))
        count += n
        return new
    return CPP_STRING_RE.sub(literal, text), count


def rename_cpp_strings(tree):
    """Rename the user-visible C++ strings; returns how many were changed."""
    total = 0
    for rel in CPP_STRING_FILES:
        path = os.path.join(tree, rel)
        if not os.path.isfile(path):
            print(f"beryllium-name-substitution: warning: {rel} not found; "
                  "Helium may have moved it", file=sys.stderr)
            continue
        with open(path, encoding="utf-8") as f:
            text, count = rename_in_string_literals(f.read())
        if count:
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
        print(f"beryllium-name-substitution: {count} strings renamed in {rel}")
        total += count
    return total


def tree_argument(argv):
    """The -t/--tree argument for a real --sub run, else None."""
    if "--sub" not in argv or "--dry-run" in argv:
        return None
    for i, arg in enumerate(argv):
        if arg in ("-t", "--tree") and i + 1 < len(argv):
            return argv[i + 1]
        if arg.startswith("--tree="):
            return arg.split("=", 1)[1]
    return None


def main():
    sys.path.insert(0, os.path.abspath(HELIUM_UTILS))
    import name_substitution_utils as util  # pylint: disable=import-outside-toplevel
    install(util)
    import name_substitution as ns  # pylint: disable=import-outside-toplevel
    ns.replacement_sanity = lambda: sanity(util)
    # Worker processes must inherit the swapped rules, so fork rather than
    # spawn a fresh interpreter (Python 3.14 defaults to forkserver).
    multiprocessing.set_start_method("fork", force=True)
    tree = tree_argument(sys.argv[1:])
    ns.main()
    if tree:
        rename_cpp_strings(tree)


if __name__ == "__main__":
    main()
