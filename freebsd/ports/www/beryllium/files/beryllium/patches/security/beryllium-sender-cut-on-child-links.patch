 void LimitSentDescriptor(int fd, pid_t peer) {
+  // The browser knows the renderer's pid. Another child sending over a link
+  // the browser marked does not (|peer| is 0); the log line then names no
+  // pid, and the sender is the process that wrote the line.
+  const std::string to =
+      peer > 0 ? "confined renderer pid " + NumberToString(peer)
+               : std::string("confined renderer on a link the browser marked");
   std::string what;
   const std::optional<DescriptorKind> kind = DescriptorKindOf(fd, &what);
   if (kind && *kind != DescriptorKind::kDirectory) {
     if (!LimitDescriptorRights(fd, *kind)) {
       PLOG(ERROR) << "beryllium-sandbox: " << what << " (fd " << fd
-                  << ") bound for confined renderer pid " << peer
-                  << " could not be limited";
+                  << ") bound for " << to << " could not be limited";
       RemoveAllRights(fd);
       return;
     }
     VLOG(1) << "beryllium-sandbox: cut " << what << " (fd " << fd
-            << ") bound for confined renderer pid " << peer;
+            << ") bound for " << to;
     return;
   }
   LOG(ERROR) << "beryllium-sandbox: " << what << " (fd " << fd
-             << ") bound for confined renderer pid " << peer
+             << ") bound for " << to
              << ", which it may not hold: every right removed before sending";
   RemoveAllRights(fd);
 }
