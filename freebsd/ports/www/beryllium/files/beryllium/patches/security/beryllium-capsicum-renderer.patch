+// Beryllium: uname() reads kern.version, which Capsicum capability mode
+// refuses. On FreeBSD keep the first answer, which a sandboxed process takes
+// before it locks down (sandbox_freebsd.cc); the system name, release and
+// machine do not change while the browser runs.
+int Uname(struct utsname* info) {
+#if BUILDFLAG(IS_FREEBSD)
+  static const std::optional<struct utsname> cached =
+      []() -> std::optional<struct utsname> {
+    struct utsname u;
+    if (uname(&u) < 0) {
+      return std::nullopt;
+    }
+    return u;
+  }();
+  if (!cached) {
+    return -1;
+  }
+  *info = *cached;
+  return 0;
+#else
+  return uname(info);
+#endif
+}
