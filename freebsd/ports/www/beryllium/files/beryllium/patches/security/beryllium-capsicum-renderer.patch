 namespace sandbox {
 namespace policy {
 
+namespace {
+
+// Beryllium, Phase 2 (plan/14-RENDERER-SANDBOX.md, feature matrix S-REN-01):
+// renderers enter Capsicum capability mode at the end of InitializeSandbox(),
+// for now only when base::freebsd::kBerylliumCapsicumRenderer is enabled
+// (--enable-features=BerylliumCapsicumRenderer; the browser reads the same
+// feature to treat its renderers as confined peers and cut what it sends
+// them), so the lockdown can be tested without affecting daily use.
+// BerylliumCapsicumTrap also sets PROC_TRAPCAP_CTL, so the first call
+// capability mode refuses ends the renderer with SIGTRAP and a backtrace
+// instead of failing quietly.
+BASE_FEATURE(kBerylliumCapsicumTrap, base::FEATURE_DISABLED_BY_DEFAULT);
+
+// Written with utrace(2) at the lockdown point, whether or not the renderer
+// then locks down: the Capsicum survey (freebsd/tests/browser, ktrace -t u)
+// splits each process's trace there, separating what happens before the
+// lockdown (allowed) from what happens after it (must work in capability
+// mode). It is the last call before cap_enter(), so the lockdown's own
+// preparation (the descriptor sweep reads kern.proc.filedesc) counts as
+// before. utrace is a no-op unless the process is traced.
+constexpr char kLockdownMarker[] = "BERYLLIUM-LOCKDOWN";
+
+// What a renderer must read before capability mode refuses it, found by the
+// Capsicum survey (4 November 2026): the memory and shared-memory sysctls
+// and uname() are cached in base/system on FreeBSD once read; the executable
+// path comes from kern.proc.pathname; time zone data from /etc/localtime.
+// From the 2026 Capsicum prototype for the FreeBSD port (plan/15): libc's
+// message catalogue, and libgcc_s, which libthr loads by path for unwinding
+// when a thread exits; loaded now, a later dlopen finds it in memory.
+void WarmUpForCapabilityMode() {
+  std::ignore = base::SysInfo::AmountOfTotalPhysicalMemory();
+  std::ignore = base::SysInfo::MaxSharedMemorySize();
+  std::ignore = base::SysInfo::OperatingSystemName();
+  std::ignore = base::SysInfo::OperatingSystemVersion();
+  std::ignore = base::SysInfo::OperatingSystemArchitecture();
+  std::ignore = base::SysInfo::KernelVersionNumber::Current();
+  std::ignore = base::SysInfo::NumberOfProcessors();
+  base::FilePath unused;
+  base::PathService::Get(base::FILE_EXE, &unused);
+  base::PathService::Get(base::DIR_EXE, &unused);
+  base::PathService::Get(base::DIR_MODULE, &unused);
+  base::PathService::Get(base::DIR_ASSETS, &unused);
+  caph_cache_tzdata();
+  caph_cache_catpages();
+  dlopen("/lib/libgcc_s.so.1", RTLD_LAZY);
+  time_t now = time(nullptr);
+  struct tm local;
+  localtime_r(&now, &local);
+}
+
+// What a renderer may hold at the lockdown point, and with which rights:
+// the policy in base/posix/capsicum_rights.h (plan/06 section 3.2; feature
+// matrix S-REN-04 and S-REN-05). Descriptors 0 to 2 are stdio, limited by
+// caph_limit_stdio(). Every other descriptor is judged by the type the
+// kernel reports for it (kern.proc.filedesc) and cut to its kind's rights;
+// a read-only file must also be one of the browser's own resource files
+// (under its assets directory), since that is all a renderer is given by
+// then; a socket must be an unnamed Mojo socket pair; a directory is
+// closed (lookups beneath one work in capability mode); anything else (a
+// writable, unnamed or foreign file, a device, a terminal, a semaphore, a
+// process descriptor, a network or named socket...) breaks the policy: the
+// lockdown fails and the renderer ends. What the renderer creates or
+// receives after the lockdown is limited where it appears (the message
+// pump, the receive paths of Mojo and base::UnixDomainSocket, socket pair
+// creation, shared memory creation). RendererMain() calls
+// InitializeSandbox() before RenderProcessImpl and RenderThreadImpl exist
+// (content/renderer/renderer_main.cc, the early path every platform but
+// Windows and macOS takes), so no IO thread runs during the sweep; the
+// threads that can exist are startup tracing's and the hang watcher's, not
+// yet started. The lockdown records the thread count at that moment
+// (|threads|, from kern.proc.pid) so the claim is checked, not assumed, and
+// ExpectConfinement() turns the receive-path limits on before the snapshot
+// as a precaution against any thread that does run.
+struct Confinement {
+  int closed_directories = 0;
+  int limited = 0;
+  int threads = -1;       // threads in the process at the lockdown point
+  std::string violation;  // empty when the policy held
+};
+
+// The number of threads in this process, from the kernel, or -1 with the
+// reason in the log. kern.proc.pid with KERN_PROC_INC_THREAD answers one
+// kinfo_proc per thread, each starting with its own size (ki_structsize),
+// so the count holds even on a kernel whose kinfo_proc is not the size of
+// the headers this was built with. 0.20.3.13 asked for one record of the
+// built-in size, got -1 in every renderer, and logged nothing about why.
+int ThreadCount() {
+  static_assert(offsetof(struct kinfo_proc, ki_structsize) == 0,
+                "ki_structsize is read as the first int of each record");
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID | KERN_PROC_INC_THREAD,
+                static_cast<int>(getpid())};
+  size_t len = 0;
+  if (sysctl(mib, 4, nullptr, &len, nullptr, 0) != 0 || len == 0) {
+    PLOG(WARNING) << "beryllium-sandbox: kern.proc.pid (size), len=" << len;
+    return -1;
+  }
+  len += len / 2;  // room for records added meanwhile
+  std::vector<char> records(len);
+  if (sysctl(mib, 4, records.data(), &len, nullptr, 0) != 0) {
+    PLOG(WARNING) << "beryllium-sandbox: kern.proc.pid, len=" << len;
+    return -1;
+  }
+  int structsize = 0;
+  if (len >= sizeof(structsize)) {
+    memcpy(&structsize, records.data(), sizeof(structsize));
+  }
+  if (structsize <= 0 || len % static_cast<size_t>(structsize) != 0) {
+    LOG(WARNING) << "beryllium-sandbox: kern.proc.pid answered " << len
+                 << " bytes in records of " << structsize
+                 << " (kinfo_proc is " << sizeof(struct kinfo_proc)
+                 << " here)";
+    return -1;
+  }
+  return static_cast<int>(len / static_cast<size_t>(structsize));
+}
+
+// Applies the policy above to every descriptor. On a violation, |violation|
+// names the descriptor and errno is EPERM; on a failed system call, errno
+// says what failed.
+Confinement ConfineDescriptors() {
+  Confinement result;
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_FILEDESC,
+                static_cast<int>(getpid())};
+  size_t len = 0;
+  if (sysctl(mib, 4, nullptr, &len, nullptr, 0) != 0) {
+    result.violation = "the descriptor table could not be read";
+    return result;
+  }
+  len += len / 4;  // room for descriptors opened meanwhile
+  std::vector<char> table(len);
+  if (sysctl(mib, 4, table.data(), &len, nullptr, 0) != 0) {
+    result.violation = "the descriptor table could not be read";
+    return result;
+  }
+  base::FilePath assets;
+  if (!base::PathService::Get(base::DIR_ASSETS, &assets) || assets.empty()) {
+    result.violation = "the assets directory is unknown";
+    errno = EPERM;
+    return result;
+  }
+  const std::string assets_prefix = assets.AsEndingWithSeparator().value();
+  // Each entry is a kinfo_file cut after its path; every field read below
+  // sits before kf_path. Anything else in the table is a reason to stop.
+  constexpr size_t kMinEntry = offsetof(struct kinfo_file, kf_path) + 1;
+  for (size_t offset = 0; offset + sizeof(int) <= len;) {
+    const auto* kf =
+        reinterpret_cast<const struct kinfo_file*>(table.data() + offset);
+    const int size = kf->kf_structsize;
+    if (size == 0) {
+      break;
+    }
+    if (size < 0 || static_cast<size_t>(size) < kMinEntry ||
+        static_cast<size_t>(size) > len - offset) {
+      result.violation = "malformed descriptor table";
+      errno = EPERM;
+      return result;
+    }
+    offset += static_cast<size_t>(size);
+    const int fd = kf->kf_fd;
+    // Negative: the working directory, root and text entries; 0 to 2: stdio.
+    if (fd < 3) {
+      continue;
+    }
+    std::string what;
+    const std::optional<base::freebsd::DescriptorKind> kind =
+        base::freebsd::DescriptorKindFromKinfo(*kf, &what);
+    if (!kind) {
+      result.violation = "fd " + base::NumberToString(fd) + ": " + what;
+      errno = EPERM;
+      return result;
+    }
+    if (*kind == base::freebsd::DescriptorKind::kDirectory) {
+      close(fd);
+      ++result.closed_directories;
+      continue;
+    }
+    if (*kind == base::freebsd::DescriptorKind::kReadOnlyFile &&
+        std::string(kf->kf_path).compare(0, assets_prefix.size(),
+                                         assets_prefix) != 0) {
+      result.violation = "fd " + base::NumberToString(fd) + ": " + what +
+                         " is not under " + assets_prefix;
+      errno = EPERM;
+      return result;
+    }
+    if (!base::freebsd::LimitDescriptorRights(fd, *kind)) {
+      if (errno == EBADF) {
+        continue;  // closed by another thread since the table was read
+      }
+      result.violation = "fd " + base::NumberToString(fd) + " (" + what +
+                         "): rights could not be limited";
+      return result;
+    }
+    ++result.limited;
+  }
+  return result;
+}
+
+// Enters capability mode; returns false, with errno set, if it did not.
+// |confinement| receives what was done to the descriptors, or what stopped
+// the lockdown.
+bool LockDownRenderer(Confinement* confinement) {
+  WarmUpForCapabilityMode();
+  if (!base::FeatureList::IsEnabled(
+          base::freebsd::kBerylliumCapsicumRenderer)) {
+    utrace(kLockdownMarker, sizeof(kLockdownMarker) - 1);
+    return true;
+  }
+  confinement->threads = ThreadCount();
+  base::freebsd::ExpectConfinement();
+  if (base::FeatureList::IsEnabled(kBerylliumCapsicumTrap)) {
+    int trap = PROC_TRAPCAP_CTL_ENABLE;
+    if (procctl(P_PID, getpid(), PROC_TRAPCAP_CTL, &trap) != 0) {
+      PLOG(WARNING) << "beryllium-sandbox: PROC_TRAPCAP_CTL";
+    }
+  }
+  *confinement = ConfineDescriptors();
+  if (!confinement->violation.empty()) {
+    return false;
+  }
+  // Standard input and output keep only the rights stdio needs (a closed
+  // stream is fine). Failing that, the renderer would keep a stream with
+  // every right, so it ends instead.
+  if (caph_limit_stdio() != 0) {
+    confinement->violation = "the standard streams could not be limited";
+    return false;
+  }
+  utrace(kLockdownMarker, sizeof(kLockdownMarker) - 1);
+  if (cap_enter() != 0) {
+    return false;
+  }
+  u_int mode = 0;
+  if (cap_getmode(&mode) != 0) {
+    return false;
+  }
+  if (mode == 0) {
+    errno = EPERM;
+    return false;
+  }
+  return true;
+}
