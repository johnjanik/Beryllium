 namespace sandbox {
 namespace policy {
 
+namespace {
+
+// Beryllium, Phase 2 (plan/14-RENDERER-SANDBOX.md, feature matrix S-REN-01):
+// renderers enter Capsicum capability mode at the end of InitializeSandbox(),
+// for now only when this feature is enabled
+// (--enable-features=BerylliumCapsicumRenderer), so the lockdown can be tested
+// without affecting daily use. BerylliumCapsicumTrap also sets
+// PROC_TRAPCAP_CTL, so the first call capability mode refuses ends the
+// renderer with SIGTRAP and a backtrace instead of failing quietly.
+BASE_FEATURE(kBerylliumCapsicumRenderer, base::FEATURE_DISABLED_BY_DEFAULT);
+BASE_FEATURE(kBerylliumCapsicumTrap, base::FEATURE_DISABLED_BY_DEFAULT);
+
+// Written with utrace(2) at the lockdown point, whether or not the renderer
+// then locks down: the Capsicum survey (freebsd/tests/browser, ktrace -t u)
+// splits each process's trace there, separating what happens before the
+// lockdown (allowed) from what happens after it (must work in capability
+// mode). It is the last call before cap_enter(), so the lockdown's own
+// preparation (the descriptor sweep reads kern.proc.filedesc) counts as
+// before. utrace is a no-op unless the process is traced.
+constexpr char kLockdownMarker[] = "BERYLLIUM-LOCKDOWN";
+
+// What a renderer must read before capability mode refuses it, found by the
+// Capsicum survey (4 November 2026): the memory and shared-memory sysctls
+// and uname() are cached in base/system on FreeBSD once read; the executable
+// path comes from kern.proc.pathname; time zone data from /etc/localtime.
+// From the 2026 Capsicum prototype for the FreeBSD port (plan/15): libc's
+// message catalogue, and libgcc_s, which libthr loads by path for unwinding
+// when a thread exits; loaded now, a later dlopen finds it in memory.
+void WarmUpForCapabilityMode() {
+  std::ignore = base::SysInfo::AmountOfTotalPhysicalMemory();
+  std::ignore = base::SysInfo::MaxSharedMemorySize();
+  std::ignore = base::SysInfo::OperatingSystemName();
+  std::ignore = base::SysInfo::OperatingSystemVersion();
+  std::ignore = base::SysInfo::OperatingSystemArchitecture();
+  std::ignore = base::SysInfo::KernelVersionNumber::Current();
+  std::ignore = base::SysInfo::NumberOfProcessors();
+  base::FilePath unused;
+  base::PathService::Get(base::FILE_EXE, &unused);
+  base::PathService::Get(base::DIR_EXE, &unused);
+  base::PathService::Get(base::DIR_MODULE, &unused);
+  base::PathService::Get(base::DIR_ASSETS, &unused);
+  caph_cache_tzdata();
+  caph_cache_catpages();
+  dlopen("/lib/libgcc_s.so.1", RTLD_LAZY);
+  time_t now = time(nullptr);
+  struct tm local;
+  localtime_r(&now, &local);
+}
+
+// What a renderer may hold at the lockdown point, and with which rights
+// (plan/06 section 3.2; feature matrix S-REN-04 and S-REN-05). Descriptors 0
+// to 2 are stdio, left to caph_limit_stdio(). Every other descriptor is
+// judged by the type the kernel reports for it (kern.proc.filedesc):
+//  - a read-only regular file with a path (the resource paks and the V8
+//    snapshot, opened by path at start-up) keeps read, seek, read-only
+//    mapping, fstat and F_GETFL;
+//  - a socket (the Mojo channel and the ipcz transports to other processes)
+//    keeps send, receive, event, fstat, shutdown, getsockopt, setsockopt and
+//    F_GETFL/F_SETFL; never connect, bind, listen or accept;
+//  - a kqueue keeps kevent, event and fstat: Chromium's epoll message pump
+//    runs on epoll-shim here, whose epoll_wait() polls its kqueue before
+//    each kevent() (without CAP_EVENT the poll fails at once and every
+//    renderer spins: 0.20.3.8, 6 million refusals in the survey);
+//  - an eventfd, pipe or fifo keeps read, write, event, fstat,
+//    F_GETFL/F_SETFL and the one ioctl FIONREAD, which epoll-shim uses to
+//    tell pipes from eventfds and kqueues when they are registered;
+//  - shared memory keeps what its creator gave it, less truncation,
+//    executable mapping and ownership changes (rights only ever shrink);
+//  - a directory is closed: lookups beneath it work in capability mode;
+//  - anything else (a writable or unnamed regular file, a device, a
+//    terminal, a semaphore, a process descriptor...) breaks the policy: the
+//    lockdown fails and the renderer ends.
+// No other descriptor keeps any ioctl. What arrives later over the Mojo
+// channel carries the rights its sender gave it; limiting those before they
+// are sent is the browser's part (S-IPC-01).
+struct Confinement {
+  int closed_directories = 0;
+  int limited = 0;
+  std::string violation;  // empty when the policy held
+};
+
+// Cuts |fd| down to the rights in |allowed| that it has (never more: the
+// kernel refuses to widen rights), the fcntl commands in |fcntls| it may
+// use, and the |nioctls| ioctls in |ioctls| (none when nioctls is 0).
+bool LimitTo(int fd,
+             const cap_rights_t* allowed,
+             uint32_t fcntls,
+             const cap_ioctl_t* ioctls = nullptr,
+             size_t nioctls = 0) {
+  cap_rights_t have;
+  if (cap_rights_get(fd, &have) != 0) {
+    return false;
+  }
+  cap_rights_t excess = have;
+  cap_rights_remove(&excess, allowed);  // what it has beyond the policy
+  cap_rights_remove(&have, &excess);    // what it has within the policy
+  uint32_t have_fcntls = 0;
+  if (cap_fcntls_get(fd, &have_fcntls) != 0) {
+    return false;
+  }
+  return cap_rights_limit(fd, &have) == 0 &&
+         cap_fcntls_limit(fd, have_fcntls & fcntls) == 0 &&
+         cap_ioctls_limit(fd, ioctls, nioctls) == 0;
+}
+
+std::string DescribeDescriptor(const struct kinfo_file* kf) {
+  const std::string path =
+      kf->kf_path[0] ? std::string(" ") + kf->kf_path : std::string();
+  switch (kf->kf_type) {
+    case KF_TYPE_VNODE:
+      switch (kf->kf_vnode_type) {
+        case KF_VTYPE_VREG:
+          if (kf->kf_flags & (KF_FLAG_WRITE | KF_FLAG_APPEND)) {
+            return "writable file" + (path.empty() ? " with no name" : path);
+          }
+          return "file with no name";
+        case KF_VTYPE_VCHR:
+        case KF_VTYPE_VBLK:
+          return "device" + path;
+        default:
+          return "vnode of type " + base::NumberToString(kf->kf_vnode_type) +
+                 path;
+      }
+    case KF_TYPE_MQUEUE:
+      return "message queue";
+    case KF_TYPE_SEM:
+      return "semaphore";
+    case KF_TYPE_PTS:
+      return "terminal";
+    case KF_TYPE_PROCDESC:
+      return "process descriptor";
+    case KF_TYPE_DEV:
+      return "device" + path;
+    default:
+      return "descriptor of type " + base::NumberToString(kf->kf_type);
+  }
+}
+
+// Applies the policy above to every descriptor. On a violation, |violation|
+// names the descriptor and errno is EPERM; on a failed system call, errno
+// says what failed.
+Confinement ConfineDescriptors() {
+  Confinement result;
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_FILEDESC,
+                static_cast<int>(getpid())};
+  size_t len = 0;
+  if (sysctl(mib, 4, nullptr, &len, nullptr, 0) != 0) {
+    result.violation = "the descriptor table could not be read";
+    return result;
+  }
+  len += len / 4;  // room for descriptors opened meanwhile
+  std::vector<char> table(len);
+  if (sysctl(mib, 4, table.data(), &len, nullptr, 0) != 0) {
+    result.violation = "the descriptor table could not be read";
+    return result;
+  }
+
+  cap_rights_t file_rights, socket_rights, kqueue_rights, event_rights,
+      shm_rights;
+  cap_rights_init(&file_rights, CAP_PREAD, CAP_MMAP_R, CAP_FSTAT, CAP_FCNTL);
+  cap_rights_init(&socket_rights, CAP_RECV, CAP_SEND, CAP_EVENT, CAP_FSTAT,
+                  CAP_FCNTL, CAP_SHUTDOWN, CAP_GETSOCKOPT, CAP_SETSOCKOPT);
+  cap_rights_init(&kqueue_rights, CAP_KQUEUE, CAP_EVENT, CAP_FSTAT);
+  cap_rights_init(&event_rights, CAP_READ, CAP_WRITE, CAP_EVENT, CAP_FSTAT,
+                  CAP_FCNTL, CAP_IOCTL);
+  const cap_ioctl_t event_ioctls[] = {FIONREAD};
+  cap_rights_init(&shm_rights, CAP_READ, CAP_WRITE, CAP_SEEK, CAP_MMAP_RW,
+                  CAP_FSTAT, CAP_FCNTL);
+  constexpr uint32_t kGetFl = CAP_FCNTL_GETFL;
+  constexpr uint32_t kGetSetFl = CAP_FCNTL_GETFL | CAP_FCNTL_SETFL;
+
+  for (size_t offset = 0; offset + sizeof(int) <= len;) {
+    const auto* kf =
+        reinterpret_cast<const struct kinfo_file*>(table.data() + offset);
+    if (kf->kf_structsize <= 0) {
+      break;
+    }
+    offset += static_cast<size_t>(kf->kf_structsize);
+    const int fd = kf->kf_fd;
+    // Negative: the working directory, root and text entries; 0 to 2: stdio.
+    if (fd < 3) {
+      continue;
+    }
+    const cap_rights_t* allowed = nullptr;
+    uint32_t fcntls = 0;
+    const cap_ioctl_t* ioctls = nullptr;
+    size_t nioctls = 0;
+    switch (kf->kf_type) {
+      case KF_TYPE_VNODE:
+        if (kf->kf_vnode_type == KF_VTYPE_VDIR) {
+          close(fd);
+          ++result.closed_directories;
+          continue;
+        }
+        if (kf->kf_vnode_type == KF_VTYPE_VREG &&
+            !(kf->kf_flags & (KF_FLAG_WRITE | KF_FLAG_APPEND)) &&
+            kf->kf_path[0] == '/') {
+          allowed = &file_rights;
+          fcntls = kGetFl;
+        }
+        break;
+      case KF_TYPE_SOCKET:
+        allowed = &socket_rights;
+        fcntls = kGetSetFl;
+        break;
+      case KF_TYPE_PIPE:
+      case KF_TYPE_FIFO:
+      case KF_TYPE_EVENTFD:
+        allowed = &event_rights;
+        fcntls = kGetSetFl;
+        ioctls = event_ioctls;
+        nioctls = 1;
+        break;
+      case KF_TYPE_KQUEUE:
+        allowed = &kqueue_rights;
+        break;
+      case KF_TYPE_SHM:
+        allowed = &shm_rights;
+        fcntls = kGetFl;
+        break;
+      default:
+        break;
+    }
+    if (!allowed) {
+      result.violation =
+          "fd " + base::NumberToString(fd) + ": " + DescribeDescriptor(kf);
+      errno = EPERM;
+      return result;
+    }
+    if (!LimitTo(fd, allowed, fcntls, ioctls, nioctls)) {
+      if (errno == EBADF) {
+        continue;  // closed by another thread since the table was read
+      }
+      result.violation = "fd " + base::NumberToString(fd) +
+                         ": rights could not be limited";
+      return result;
+    }
+    ++result.limited;
+  }
+  return result;
+}
+
+// Enters capability mode; returns false, with errno set, if it did not.
+// |confinement| receives what was done to the descriptors, or what stopped
+// the lockdown.
+bool LockDownRenderer(Confinement* confinement) {
+  WarmUpForCapabilityMode();
+  if (!base::FeatureList::IsEnabled(kBerylliumCapsicumRenderer)) {
+    utrace(kLockdownMarker, sizeof(kLockdownMarker) - 1);
+    return true;
+  }
+  if (base::FeatureList::IsEnabled(kBerylliumCapsicumTrap)) {
+    int trap = PROC_TRAPCAP_CTL_ENABLE;
+    if (procctl(P_PID, getpid(), PROC_TRAPCAP_CTL, &trap) != 0) {
+      PLOG(WARNING) << "beryllium-sandbox: PROC_TRAPCAP_CTL";
+    }
+  }
+  *confinement = ConfineDescriptors();
+  if (!confinement->violation.empty()) {
+    return false;
+  }
+  // Standard input and output keep only the rights stdio needs.
+  if (caph_limit_stdio() != 0) {
+    PLOG(WARNING) << "beryllium-sandbox: caph_limit_stdio";
+  }
+  utrace(kLockdownMarker, sizeof(kLockdownMarker) - 1);
+  if (cap_enter() != 0) {
+    return false;
+  }
+  u_int mode = 0;
+  if (cap_getmode(&mode) != 0) {
+    return false;
+  }
+  if (mode == 0) {
+    errno = EPERM;
+    return false;
+  }
+  return true;
+}
