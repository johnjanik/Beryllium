--- a/base/posix/capsicum_rights.h
+++ b/base/posix/capsicum_rights.h
@@ -108,6 +108,32 @@
 BASE_EXPORT int AttestedTotal();
 BASE_EXPORT int EndedUnattestedTotal();
 
+// Beryllium (plan/18 section 3.2, P4; feature matrix S-KRN-03): what this
+// kernel does for a confined process, found by trying it. A version number
+// does not say: the fix for FreeBSD-SA-26:28.capsicum (sigqueue() lacked the
+// capability-mode restriction, so a confined process could signal another)
+// is in the supported branches at patch levels a -CURRENT or a locally
+// built kernel does not carry in its name.
+enum class KernelFact { kYes, kNo, kNotChecked };
+struct KernelCheck {
+  // cap_enter() works: the kernel has capability mode.
+  KernelFact capability_mode = KernelFact::kNotChecked;
+  // In capability mode, kill() and sigqueue() to another process are both
+  // refused.
+  KernelFact signals_confined = KernelFact::kNotChecked;
+};
+
+// Makes the check: forks a child that enters capability mode, tries
+// kill(parent, 0) and sigqueue(parent, 0), both of which must fail, and
+// exits with the answer. Signal 0 delivers nothing on any kernel. Called
+// once by the browser process when it starts, before it has other threads;
+// logs one line for each fact that is not as the lockdown needs it.
+BASE_EXPORT void CheckKernelForConfinement();
+
+// The result, or "not checked" in a process that did not make the check
+// (only the browser does).
+BASE_EXPORT KernelCheck KernelCheckResult();
+
