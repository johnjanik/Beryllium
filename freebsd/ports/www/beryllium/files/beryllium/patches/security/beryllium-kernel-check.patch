+namespace {
+
+// Written once, by the browser's main thread at start, before any reader.
+std::atomic<int> g_kernel_capability_mode{
+    static_cast<int>(KernelFact::kNotChecked)};
+std::atomic<int> g_kernel_signals_confined{
+    static_cast<int>(KernelFact::kNotChecked)};
+
+// The child's exit codes.
+constexpr int kProbeFine = 0;
+constexpr int kProbeNoCapabilityMode = 71;
+constexpr int kProbeSignalAllowed = 72;
+
+}  // namespace
+
+void CheckKernelForConfinement() {
+  const pid_t parent = getpid();
+  const pid_t child = fork();
+  if (child < 0) {
+    PLOG(WARNING) << "beryllium-sandbox: kernel check not made (fork)";
+    return;
+  }
+  if (child == 0) {
+    // Only system calls from here: the child is a copy of a process that
+    // may hold locks.
+    if (cap_enter() != 0) {
+      _exit(kProbeNoCapabilityMode);
+    }
+    u_int mode = 0;
+    if (cap_getmode(&mode) != 0 || mode == 0) {
+      _exit(kProbeNoCapabilityMode);
+    }
+    union sigval value;
+    value.sival_int = 0;
+    if (kill(parent, 0) == 0 || sigqueue(parent, 0, value) == 0) {
+      _exit(kProbeSignalAllowed);
+    }
+    _exit(kProbeFine);
+  }
+  int status = 0;
+  pid_t waited;
+  do {
+    waited = waitpid(child, &status, 0);
+  } while (waited < 0 && errno == EINTR);
+  if (waited != child || !WIFEXITED(status)) {
+    LOG(WARNING) << "beryllium-sandbox: kernel check not made (the child "
+                    "did not report)";
+    return;
+  }
+  const int code = WEXITSTATUS(status);
+  if (code == kProbeNoCapabilityMode) {
+    g_kernel_capability_mode.store(static_cast<int>(KernelFact::kNo));
+    LOG(ERROR) << "beryllium-sandbox: this kernel has no capability mode "
+                  "(cap_enter failed in a test process). With the renderer "
+                  "lockdown on, every renderer ends at its lockdown and no "
+                  "page loads.";
+    return;
+  }
+  g_kernel_capability_mode.store(static_cast<int>(KernelFact::kYes));
+  if (code == kProbeSignalAllowed) {
+    g_kernel_signals_confined.store(static_cast<int>(KernelFact::kNo));
+    LOG(ERROR) << "beryllium-sandbox: on this kernel a process in capability "
+                  "mode can signal another process (FreeBSD-SA-26:28.capsicum "
+                  "is not fixed in it). A locked-down renderer is confined "
+                  "less than Beryllium says until the kernel is updated.";
+    return;
+  }
+  if (code == kProbeFine) {
+    g_kernel_signals_confined.store(static_cast<int>(KernelFact::kYes));
+  }
+}
+
+KernelCheck KernelCheckResult() {
+  KernelCheck result;
+  result.capability_mode =
+      static_cast<KernelFact>(g_kernel_capability_mode.load());
+  result.signals_confined =
+      static_cast<KernelFact>(g_kernel_signals_confined.load());
+  return result;
+}
+
