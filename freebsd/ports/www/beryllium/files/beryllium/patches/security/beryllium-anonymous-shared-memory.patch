+#elif BUILDFLAG(IS_FREEBSD)
+
+// Beryllium (plan/14-RENDERER-SANDBOX.md increment 4, feature matrix S-SHM-01
+// and S-SHM-02): on FreeBSD the region is an anonymous memfd (a POSIX shared
+// memory object with no name) instead of an unlinked file in the temporary
+// directory. The file-based fallback below put every region, page content
+// included, on the file system of TMPDIR (usually /tmp, often ZFS or UFS on
+// disk), handed each renderer descriptors for regular files it could write,
+// resize and change, and needs a directory a confined process cannot reach.
+//
+// Size seals, as on Linux: no holder of a descriptor, including a less
+// trusted process the region is shared with, can shrink it (making other
+// processes fault) or grow it. FreeBSD has no /proc/self/fd to reopen a memfd
+// O_RDONLY, so the read-only descriptor is a duplicate whose Capsicum rights
+// allow reading and read-only mapping only (CheckFDAccessMode() treats it as
+// O_RDONLY). The writable descriptor keeps only the rights mapping needs.
+// Neither may map the region executable. Rights travel with a descriptor when
+// it is sent to another process and can never be widened.
+ScopedFDPair CreateAnonymousRegion(PlatformSharedMemoryRegion::Mode mode,
+                                   size_t size) {
+  static constexpr char kName[] = "shared-memory-region";
+  ScopedFD fd(memfd_create(kName, MFD_CLOEXEC | MFD_ALLOW_SEALING));
+  if (!fd.is_valid()) {
+    DPLOG(ERROR) << "memfd_create";
+    return {};
+  }
+
+  if (HANDLE_EINTR(ftruncate(fd.get(), checked_cast<off_t>(size))) != 0) {
+    DPLOG(ERROR) << "ftruncate";
+    return {};
+  }
+
+  if (fcntl(fd.get(), F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL) !=
+      0) {
+    DPLOG(ERROR) << "fcntl(F_ADD_SEALS)";
+    return {};
+  }
+
+  ScopedFD readonly_fd;
+  if (mode == PlatformSharedMemoryRegion::Mode::kWritable) {
+    readonly_fd.reset(HANDLE_EINTR(fcntl(fd.get(), F_DUPFD_CLOEXEC, 0)));
+    if (!readonly_fd.is_valid()) {
+      DPLOG(ERROR) << "fcntl(F_DUPFD_CLOEXEC)";
+      return {};
+    }
+  }
+
+  // fstat() for size checks, fcntl(F_GETFL) for CheckFDAccessMode().
+  const auto limit = [](int limited_fd, bool writable) {
+    cap_rights_t rights;
+    if (writable) {
+      cap_rights_init(&rights, CAP_MMAP_RW, CAP_FSTAT, CAP_FCNTL);
+    } else {
+      cap_rights_init(&rights, CAP_MMAP_R, CAP_FSTAT, CAP_FCNTL);
+    }
+    if (cap_rights_limit(limited_fd, &rights) != 0) {
+      DPLOG(ERROR) << "cap_rights_limit";
+      return false;
+    }
+    if (cap_fcntls_limit(limited_fd, CAP_FCNTL_GETFL) != 0) {
+      DPLOG(ERROR) << "cap_fcntls_limit";
+      return false;
+    }
+    return true;
+  };
+  if (!limit(fd.get(), /*writable=*/true)) {
+    return {};
+  }
+  if (readonly_fd.is_valid() && !limit(readonly_fd.get(), /*writable=*/false)) {
+    return {};
+  }
+
+  return ScopedFDPair(std::move(fd), std::move(readonly_fd));
+}
+
 #endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
 
 }  // namespace
