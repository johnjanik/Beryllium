+#if BUILDFLAG(IS_FREEBSD)
+void ChildProcessLauncherHelper::BerylliumInviteWhenConfined(
+    mojo::OutgoingInvitation invitation,
+    base::TimeTicks launched) {
+  CHECK(CurrentlyOnProcessLauncherTaskRunner(), base::NotFatalUntil::M160);
+  // How often the kernel is asked, and for how long. A renderer reaches its
+  // lockdown some hundreds of milliseconds after its launch; ten seconds is
+  // a machine too loaded to be useful, or a renderer that is not going to.
+  constexpr base::TimeDelta kAskAgainAfter = base::Milliseconds(3);
+  constexpr base::TimeDelta kGiveUpAfter = base::Seconds(10);
+
+  const base::ProcessId pid = *beryllium_confined_peer_;
+  // A renderer that has exited is not waited for, whatever it was.
+  const base::freebsd::KernelAnswer answer =
+      base::freebsd::ProcessIsGone(pid)
+          ? base::freebsd::KernelAnswer::kUnknown
+          : base::freebsd::KernelSaysCapabilityMode(pid);
+  const base::TimeDelta waited = base::TimeTicks::Now() - launched;
+  if (answer == base::freebsd::KernelAnswer::kYes) {
+    LOG(WARNING) << "beryllium-sandbox: renderer pid=" << pid << " invited "
+                 << waited.InMilliseconds()
+                 << " ms after its launch, in capability mode by the "
+                    "kernel's account";
+    SendInvitationOnLauncherThread(std::move(invitation),
+                                   child_process_.Handle());
+    return;
+  }
+  // No answer means the process has exited (or is hidden from the browser,
+  // which is no better). With --no-sandbox a renderer skips its lockdown, so
+  // there is nothing to wait for. A renderer paused for a debugger waits as
+  // long as the person debugging it likes.
+  const base::CommandLine& browser = *base::CommandLine::ForCurrentProcess();
+  const bool paused_for_a_debugger =
+      browser.HasSwitch(switches::kRendererStartupDialog) ||
+      command_line()->HasSwitch(switches::kWaitForDebugger);
+  const bool keep_asking =
+      answer == base::freebsd::KernelAnswer::kNo &&
+      !browser.HasSwitch("no-sandbox") &&
+      (paused_for_a_debugger || waited < kGiveUpAfter);
+  if (keep_asking) {
+    GetProcessLauncherTaskRunner()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ChildProcessLauncherHelper::BerylliumInviteWhenConfined,
+                       this, std::move(invitation), launched),
+        kAskAgainAfter);
+    return;
+  }
+  // Not invited. The invitation is destroyed here, which the browser's end
+  // of the connection sees as a renderer that went away.
+  base::freebsd::RecordAttestation(pid, answer);
+  LOG(ERROR) << "beryllium-sandbox: renderer pid=" << pid
+             << (answer == base::freebsd::KernelAnswer::kNo
+                     ? " is not in capability mode by the kernel's account"
+                     : " has no answer from the kernel about its capability "
+                       "mode")
+             << "; ended before it was sent anything, "
+             << waited.InMilliseconds() << " ms after its launch";
+  kill(pid, SIGKILL);
+}
+#endif  // BUILDFLAG(IS_FREEBSD)
