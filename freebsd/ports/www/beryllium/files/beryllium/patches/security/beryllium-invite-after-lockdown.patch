+bool ProcessIsGone(pid_t pid) {
+  // SZOMB in sys/proc.h, a header for the kernel's own structures: the
+  // process has exited and its parent has not collected it.
+  constexpr char kAwaitingCollection = 5;
+  int mib[] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, pid};
+  struct kinfo_proc kp;
+  size_t len = sizeof(kp);
+  if (sysctl(mib, 4, &kp, &len, nullptr, 0) != 0 || len != sizeof(kp) ||
+      static_cast<size_t>(kp.ki_structsize) != sizeof(kp) ||
+      kp.ki_pid != pid) {
+    return true;
+  }
+  return kp.ki_stat == kAwaitingCollection;
+}
