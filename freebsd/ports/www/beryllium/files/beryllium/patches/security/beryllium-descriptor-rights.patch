+std::optional<DescriptorKind> DescriptorKindFromKinfo(
+    const struct kinfo_file& kf,
+    std::string* description) {
+  const std::string path =
+      kf.kf_path[0] ? std::string(" ") + kf.kf_path : std::string();
+  switch (kf.kf_type) {
+    case KF_TYPE_VNODE:
+      switch (kf.kf_vnode_type) {
+        case KF_VTYPE_VDIR:
+          *description = "directory" + path;
+          return DescriptorKind::kDirectory;
+        case KF_VTYPE_VREG:
+          if (kf.kf_flags & (KF_FLAG_WRITE | KF_FLAG_APPEND)) {
+            *description =
+                "writable file" + (path.empty() ? " with no name" : path);
+            return std::nullopt;
+          }
+          if (path.empty()) {
+            *description = "file with no name";
+            return std::nullopt;
+          }
+          *description = "read-only file" + path;
+          return DescriptorKind::kReadOnlyFile;
+        case KF_VTYPE_VCHR:
+        case KF_VTYPE_VBLK:
+          *description = "device" + path;
+          return std::nullopt;
+        default:
+          *description =
+              "vnode of type " + NumberToString(kf.kf_vnode_type) + path;
+          return std::nullopt;
+      }
+    case KF_TYPE_SOCKET: {
+      // kf_path holds the domain's name ("local"), not a path. A listening
+      // unix socket is bound to a path, which the address check catches.
+      std::string why;
+      if (!MojoSocketShape(
+              kf.kf_sock_domain, kf.kf_sock_type,
+              reinterpret_cast<const struct sockaddr*>(&kf.kf_sa_local),
+              sizeof(kf.kf_sa_local),
+              reinterpret_cast<const struct sockaddr*>(&kf.kf_sa_peer),
+              sizeof(kf.kf_sa_peer), /*listening=*/false, &why)) {
+        *description = why;
+        return std::nullopt;
+      }
+      *description = "socket";
+      return DescriptorKind::kSocket;
+    }
+    case KF_TYPE_PIPE:
+    case KF_TYPE_FIFO:
+      *description = "pipe";
+      return DescriptorKind::kEvent;
+    case KF_TYPE_EVENTFD:
+      *description = "eventfd";
+      return DescriptorKind::kEvent;
+    case KF_TYPE_KQUEUE:
+      *description = "kqueue";
+      return DescriptorKind::kKqueue;
+    case KF_TYPE_SHM:
+      *description = "shared memory";
+      return DescriptorKind::kSharedMemory;
+    case KF_TYPE_MQUEUE:
+      *description = "message queue";
+      return std::nullopt;
+    case KF_TYPE_SEM:
+      *description = "semaphore";
+      return std::nullopt;
+    case KF_TYPE_PTS:
+      *description = "terminal";
+      return std::nullopt;
+    case KF_TYPE_PROCDESC:
+      *description = "process descriptor";
+      return std::nullopt;
+    case KF_TYPE_DEV:
+      *description = "device" + path;
+      return std::nullopt;
+    default:
+      *description = "descriptor of type " + NumberToString(kf.kf_type);
+      return std::nullopt;
+  }
+}
