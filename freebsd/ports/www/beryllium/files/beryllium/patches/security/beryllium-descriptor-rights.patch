+std::optional<DescriptorKind> DescriptorKindOf(int fd,
+                                               std::string* description) {
+  struct stat st;
+  if (fstat(fd, &st) != 0) {
+    *description = "descriptor fstat cannot describe";
+    return std::nullopt;
+  }
+  if (S_ISSOCK(st.st_mode)) {
+    int domain = -1, type = -1, listening = 0;
+    socklen_t len = sizeof(int);
+    getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &len);
+    len = sizeof(int);
+    getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &len);
+    len = sizeof(int);
+    getsockopt(fd, SOL_SOCKET, SO_ACCEPTCONN, &listening, &len);
+    // The names are asked only with the rights to ask them. A socket the
+    // browser has already cut to a socket's rights before sending it
+    // (0.20.3.13) refuses getsockname and getpeername, and each refusal
+    // showed in the 0.20.3.13 survey as a failure after the lockdown (242
+    // in 20 renderers). Whoever cut it checked its shape with the rights
+    // it had then; here it is unnamed and unconnected by construction.
+    struct sockaddr_un local = {}, peer = {};
+    socklen_t local_len = 0, peer_len = 0;
+    cap_rights_t have;
+    const bool can_name =
+        cap_rights_get(fd, &have) != 0 ||
+        (cap_rights_is_set(&have, CAP_GETSOCKNAME) &&
+         cap_rights_is_set(&have, CAP_GETPEERNAME));
+    if (can_name) {
+      local_len = sizeof(local);
+      if (getsockname(fd, reinterpret_cast<struct sockaddr*>(&local),
+                      &local_len) != 0) {
+        local_len = 0;
+      }
+      peer_len = sizeof(peer);
+      if (getpeername(fd, reinterpret_cast<struct sockaddr*>(&peer),
+                      &peer_len) != 0) {
+        peer_len = 0;  // not connected: it cannot connect without CAP_CONNECT
+      }
+    }
+    std::string why;
+    if (!MojoSocketShape(domain, type,
+                         reinterpret_cast<const struct sockaddr*>(&local),
+                         local_len,
+                         reinterpret_cast<const struct sockaddr*>(&peer),
+                         peer_len, listening != 0, &why)) {
+      *description = why;
+      return std::nullopt;
+    }
+    *description = "socket";
+    return DescriptorKind::kSocket;
+  }
+  if (S_ISFIFO(st.st_mode)) {
+    // Kqueues and eventfds report as fifos; only a kqueue accepts an empty
+    // kevent (which needs no right), anything else is EBADF.
+    const struct timespec now = {0, 0};
+    if (kevent(fd, nullptr, 0, nullptr, 0, &now) == 0) {
+      *description = "kqueue";
+      return DescriptorKind::kKqueue;
+    }
+    *description = "eventfd or pipe";
+    return DescriptorKind::kEvent;
+  }
+  if (S_ISREG(st.st_mode)) {
+    // Shared memory reports as a regular file; only it has seals.
+    if (fcntl(fd, F_GET_SEALS) >= 0) {
+      *description = "shared memory";
+      return DescriptorKind::kSharedMemory;
+    }
+    const int flags = fcntl(fd, F_GETFL);
+    if (flags >= 0 && (flags & O_ACCMODE) == O_RDONLY) {
+      *description = "read-only file";
+      return DescriptorKind::kReadOnlyFile;
+    }
+    *description = "writable file";
+    return DescriptorKind::kWritableFile;
+  }
+  if (S_ISDIR(st.st_mode)) {
+    *description = "directory";
+    return DescriptorKind::kDirectory;
+  }
+  if (S_ISCHR(st.st_mode) || S_ISBLK(st.st_mode)) {
+    *description = "device";
+    return std::nullopt;
+  }
+  *description = "descriptor of mode " + NumberToString(st.st_mode & S_IFMT);
+  return std::nullopt;
+}
+
+std::atomic<bool> g_confining{false};
+
+bool InCapabilityMode() {
+  static std::atomic<bool> known{false};
+  if (known.load(std::memory_order_relaxed)) {
+    return true;
+  }
+  u_int mode = 0;
+  if (cap_getmode(&mode) != 0 || mode == 0) {
+    return false;
+  }
+  known.store(true, std::memory_order_relaxed);
+  return true;
+}
+
+void ExpectConfinement() {
+  g_confining.store(true, std::memory_order_release);
+}
+
+bool Confining() {
+  return g_confining.load(std::memory_order_acquire) || InCapabilityMode();
+}
+
+void ExpectConfinedPeer(pid_t pid) {
+  AutoLock lock(Peers().lock);
+  Peers().pids.insert(pid);
+}
+
+void ForgetConfinedPeer(pid_t pid) {
+  AutoLock lock(Peers().lock);
+  Peers().pids.erase(pid);
+}
+
+bool IsConfinedPeer(pid_t pid) {
+  AutoLock lock(Peers().lock);
+  return Peers().pids.count(pid) != 0;
+}
+
+void LimitSentDescriptor(int fd, pid_t peer) {
+  std::string what;
+  const std::optional<DescriptorKind> kind = DescriptorKindOf(fd, &what);
+  if (kind && *kind != DescriptorKind::kDirectory) {
+    if (!LimitDescriptorRights(fd, *kind)) {
+      PLOG(ERROR) << "beryllium-sandbox: " << what << " (fd " << fd
+                  << ") bound for confined renderer pid " << peer
+                  << " could not be limited";
+      RemoveAllRights(fd);
+      return;
+    }
+    VLOG(1) << "beryllium-sandbox: cut " << what << " (fd " << fd
+            << ") bound for confined renderer pid " << peer;
+    return;
+  }
+  LOG(ERROR) << "beryllium-sandbox: " << what << " (fd " << fd
+             << ") bound for confined renderer pid " << peer
+             << ", which it may not hold: every right removed before sending";
+  RemoveAllRights(fd);
+}
+
+// True the first time |key| is seen in this process. The code behind each
+// socket pair a confined process makes is named once per site and thread
+// with a stack trace: the 0.20.3.13 log named mojo::PlatformChannel on
+// CrRendererMain and on Compositor, and could not say which caller.
+bool FirstTime(const std::string& key) {
+  static NoDestructor<Lock> lock;
+  static NoDestructor<std::set<std::string>> seen;
+  AutoLock hold(*lock);
+  return seen->insert(key).second;
+}
+
+void LimitCreatedSocketPair(const char* site, int a, int b) {
+  if (!Confining()) {
+    return;
+  }
+  for (int fd : {a, b}) {
+    if (!LimitDescriptorRights(fd, DescriptorKind::kSocket)) {
+      PLOG(ERROR) << "beryllium-sandbox: created socket (fd " << fd
+                  << ") could not be limited";
+      RemoveAllRights(fd);
+    }
+  }
+  const char* thread = PlatformThread::GetName();
+  const std::string thread_name = thread ? thread : "";
+  LOG(WARNING) << "beryllium-sandbox: socket pair made at " << site
+               << " on thread '" << thread_name << "' (fd " << a << ", fd "
+               << b << "): limited";
+  if (FirstTime(std::string(site) + " on " + thread_name)) {
+    LOG(WARNING) << "beryllium-sandbox: the first socket pair made at " << site
+                 << " on thread '" << thread_name << "' came from:\n"
+                 << debug::StackTrace().ToString();
+  }
+}
+
+void LimitReceivedDescriptor(int fd) {
+  if (!Confining()) {
+    return;
+  }
+  std::string what;
+  const std::optional<DescriptorKind> kind = DescriptorKindOf(fd, &what);
+  if (kind && *kind != DescriptorKind::kDirectory) {
+    // A writable file is admitted here, not at the lockdown point: the
+    // browser handed it over on purpose (a File System Access handle), and
+    // it keeps the writable kind's rights, which the browser cut already.
+    if (!LimitDescriptorRights(fd, *kind)) {
+      PLOG(ERROR) << "beryllium-sandbox: received " << what << " (fd " << fd
+                  << ") could not be limited";
+      RemoveAllRights(fd);
+    }
+    return;
+  }
+  LOG(ERROR) << "beryllium-sandbox: received " << what << " (fd " << fd
+             << "), which a confined process may not hold: every right removed";
+  RemoveAllRights(fd);
+}
+
