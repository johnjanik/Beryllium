+// Whether this confined process limits what it receives (the test switch
+// kBerylliumReceiveSideLimits). Asked only once the process is confining,
+// which is after its feature list exists, and said once in the log when the
+// answer is no, so a run made that way cannot be mistaken for another.
+bool ReceiveSideLimits() {
+  static const bool on = [] {
+    const bool enabled = FeatureList::IsEnabled(kBerylliumReceiveSideLimits);
+    if (!enabled) {
+      LOG(WARNING) << "beryllium-sandbox: receive-side limits are off in pid "
+                   << getpid()
+                   << " (BerylliumReceiveSideLimits disabled, a test "
+                      "configuration): what this process receives keeps the "
+                      "rights its sender left on it";
+    }
+    return enabled;
+  }();
+  return on;
+}
