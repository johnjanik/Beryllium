+
+  // Beryllium: what a page reads back from WebGL carries the canvas noise of
+  // its site, as getImageData() does. Without it readPixels() returned the
+  // exact pixels of a WebGL scene, and of any 2D canvas the page had made a
+  // texture of. Four bytes a pixel is the read every WebGL context offers
+  // and the one fingerprinting scripts make. Reads in other formats, and
+  // reads into a buffer object, are not noised.
+  if (format == GL_RGBA && type == GL_UNSIGNED_BYTE && width > 0 &&
+      height > 0) {
+    // Where the pack parameters put the pixels: a row holds |row_length|
+    // pixels if that is set and |width| if not, padded to the alignment, and
+    // skipped rows and pixels come before the first pixel read.
+    const WebGLImageConversion::PixelStoreParams params =
+        GetPackPixelStoreParams();
+    base::CheckedNumeric<size_t> row_stride =
+        params.row_length > 0 ? params.row_length : width;
+    row_stride *= 4;
+    row_stride += params.alignment - 1;
+    row_stride /= params.alignment;
+    row_stride *= params.alignment;
+    base::CheckedNumeric<size_t> first_pixel = row_stride;
+    first_pixel *= params.skip_rows;
+    base::CheckedNumeric<size_t> skipped_pixels = params.skip_pixels;
+    skipped_pixels *= 4;
+    first_pixel += skipped_pixels;
+    // A layout that does not compute gets offsets no buffer holds, and the
+    // helper then hands back zeros.
+    CanvasNoisingHelper::MaybeNoiseWebGLReadback(
+        Host()->GetTopExecutionContext(),
+        pixels->ByteSpanMaybeShared().subspan(offset_in_bytes.ValueOrDie()),
+        first_pixel.ValueOrDefault(SIZE_MAX),
+        row_stride.ValueOrDefault(SIZE_MAX), width, height, x, y);
+  }
