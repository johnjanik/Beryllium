+// static
+bool CanvasNoisingHelper::MaybeNoiseWebGLReadback(
+    ExecutionContext* execution_context,
+    base::span<uint8_t> destination,
+    size_t first_pixel_offset,
+    size_t row_stride,
+    int width,
+    int height,
+    int source_x,
+    int source_y) {
+  std::optional<HeliumNoiseHash> token_hash =
+      GetCanvasTokenHash(execution_context);
+  if (!token_hash || width <= 0 || height <= 0) {
+    return false;
+  }
+
+  const size_t row_bytes = static_cast<size_t>(width) * kChannelsPerPixel;
+  base::CheckedNumeric<size_t> end = row_stride;
+  end *= static_cast<size_t>(height - 1);
+  end += first_pixel_offset;
+  end += row_bytes;
+  // GetPixelAt() indexes with int.
+  base::CheckedNumeric<int> last_index = width;
+  last_index *= height;
+  last_index *= kChannelsPerPixel;
+  if (!end.IsValid() || end.ValueOrDie() > destination.size() ||
+      row_stride < row_bytes || !last_index.IsValid()) {
+    // Not a layout this code knows, or more than it can index. Nothing is
+    // handed back unnoised.
+    std::ranges::fill(destination, 0u);
+    return true;
+  }
+
+  // Gather the rows into one block, as the noise wants them.
+  std::vector<uint8_t> block(
+      CheckedPixelStorageSize(width, height, sizeof(uint8_t)));
+  base::span<uint8_t> pixels(block);
+  for (int y = 0; y < height; ++y) {
+    pixels.subspan(y * row_bytes, row_bytes)
+        .copy_from(destination.subspan(first_pixel_offset + y * row_stride,
+                                       row_bytes));
+  }
+
+  // The noise moves about one pixel in four of a flat area by one level. A
+  // WebGL page reads flat areas back for their exact values: the color under
+  // the pointer names the object drawn there. A pixel whose whole
+  // neighborhood in this read is one exact color is therefore put back as it
+  // was read; it tells a page nothing that one pixel of it would not.
+  const std::vector<uint8_t> original(block);
+  const base::span<const uint8_t> source_pixels(original);
+
+  HeliumNoisePixels(*token_hash, pixels, width, height, source_x, source_y);
+
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      auto source_pixel = GetPixelAt(x, y, width, source_pixels);
+      const uint32_t value = base::U32FromLittleEndian(source_pixel);
+      bool uniform = true;
+      for (int dy = -1; dy <= 1 && uniform; ++dy) {
+        const int sample_y = std::clamp(y + dy, 0, height - 1);
+        for (int dx = -1; dx <= 1 && uniform; ++dx) {
+          const int sample_x = std::clamp(x + dx, 0, width - 1);
+          uniform = base::U32FromLittleEndian(GetPixelAt(
+                        sample_x, sample_y, width, source_pixels)) == value;
+        }
+      }
+      if (uniform) {
+        GetPixelAt(x, y, width, pixels).copy_from(source_pixel);
+      }
+    }
+  }
+
+  for (int y = 0; y < height; ++y) {
+    destination.subspan(first_pixel_offset + y * row_stride, row_bytes)
+        .copy_from(pixels.subspan(y * row_bytes, row_bytes));
+  }
+  return true;
+}
+
 }  // namespace blink
