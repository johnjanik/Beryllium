			GN_OPTION_ARGS+=blink_symbol_level=0 \
			GN_OPTION_ARGS+=is_debug=false \
			GN_OPTION_ARGS+=is_official_build=true \
			GN_OPTION_ARGS+=symbol_level=0 \
			WANTSPACE="35 GB" \
			WANTMEM="8 GB"

DRIVER_MAKE_ARGS=	chromedriver

HEIMDAL_LIB_DEPENDS=	libkrb5.so.26:security/heimdal
KERBEROS_VARS=		GN_OPTION_ARGS+=use_kerberos=true
KERBEROS_VARS_OFF=	GN_OPTION_ARGS+=use_kerberos=false

LTO_VARS=		GN_OPTION_ARGS+=use_thin_lto=true \
			GN_OPTION_ARGS+=thin_lto_enable_optimizations=true \
			WANTSPACE="40 GB" \
			WANTMEM="16 GB"
LTO_VARS_OFF=		GN_OPTION_ARGS+=use_thin_lto=false

