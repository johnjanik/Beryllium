WIDEVINE_DESC=		Depend on foreign-cdm to enable playback of DRM content
WIDEVINE_RUN_DEPENDS=	foreign-cdm>0:www/foreign-cdm

.include <bsd.port.options.mk>
.include <bsd.port.pre.mk> # for COMPILER_VERSION

.if ${PORT_OPTIONS:MHEIMDAL_BASE} && !exists(/usr/lib/libkrb5.so)
IGNORE=		you have selected HEIMDAL_BASE but do not have Heimdal installed in base
.endif

LLVM_DEFAULT=		22
BUILD_DEPENDS+=		clang${LLVM_DEFAULT}:devel/llvm${LLVM_DEFAULT} \
			nasm:devel/nasm
BINARY_ALIAS+=		cpp=${LOCALBASE}/bin/clang-cpp${LLVM_DEFAULT} \
			cc=${LOCALBASE}/bin/clang${LLVM_DEFAULT} \
			c++=${LOCALBASE}/bin/clang++${LLVM_DEFAULT} \
			ar=${LOCALBASE}/bin/llvm-ar${LLVM_DEFAULT} \
			nm=${LOCALBASE}/bin/llvm-nm${LLVM_DEFAULT} \
			ld=${LOCALBASE}/bin/ld.lld${LLVM_DEFAULT}

FFMPEG_TARGET=	x64
FFMPEG_BDIR=	${WRKSRC}/third_party/ffmpeg/build.${FFMPEG_TARGET}.freebsd/${FFMPEG_BRAND}
FFMPEG_CDIR=	${WRKSRC}/third_party/ffmpeg/chromium/config/${FFMPEG_BRAND}/freebsd/${FFMPEG_TARGET}

MAKE_ENV+=	C_INCLUDE_PATH=${LOCALBASE}/include \
		CPLUS_INCLUDE_PATH=${LOCALBASE}/include \
		RUSTC_BOOTSTRAP=1 \
		GOCACHE=${WRKDIR}/go-cache

GNARGS_CMD=	${PYTHON_CMD} ${BERYLLIUM_FILES}/tools/gnargs-from-flags gen \
		--helium-flags ${WRKSRC_helium}/flags.gn \
		--fragment ${BERYLLIUM_FILES}/flags.freebsd.gn \
		--privacy-keys ${BERYLLIUM_FILES}/gn-privacy-keys.json \
		--var LOCALBASE="${LOCALBASE}" \
		--var CXXFLAGS="${CXXFLAGS}" \
		--var PINCLUDES="${PINCLUDES}" \
		--var LDFLAGS="${LDFLAGS}" \
		--var LLVM_DEFAULT="${LLVM_DEFAULT}" \
		--var PYTHON_VER="${PYTHON_VER}" \
		--var QT_TOOLDIR="${QT_TOOLDIR}" \
		${GN_OPTION_ARGS:@a@--arg '${a}'@}

pre-everything::
	@${ECHO_MSG}
	@${ECHO_MSG} "To build ${PORTNAME}, you should have at least:"
	@${ECHO_MSG} "- ${WANTMEM} of memory"
	@${ECHO_MSG} "- ${WANTSPACE} of free disk space"
	@${ECHO_MSG} "- 1.5 million free inodes"
	@${ECHO_MSG}

# Stage 0: Helium's dependencies, at the paths Helium's deps.ini gives.
post-extract:
	@${MKDIR} ${WRKSRC}/components/helium_onboarding ${WRKSRC}/third_party/ublock
	${TAR} -xf ${DISTDIR}/helium-onboarding-${ONBOARDING_VERSION}.tar.gz \
		-C ${WRKSRC}/components/helium_onboarding
	${TAR} -xf ${DISTDIR}/uBlock0_${UBLOCK_VERSION}.chromium.zip \
		-C ${WRKSRC}/third_party/ublock --strip-components 1

post-extract-SEARCHICONS-on:
	@${MKDIR} ${WRKSRC}/third_party/search_engines_data/resources_internal
	${TAR} -xf ${DISTDIR}/nonfree-search-engines-data-${SEARCHDATA_VERSION}.tar.gz \
		-C ${WRKSRC}/third_party/search_engines_data/resources_internal

# Stage 1: prune prebuilt binaries (entries absent from the -lite tarball
# are skipped and counted, see tools/prune-existing).
pre-patch:
	cd ${WRKSRC_helium} && ${PYTHON_CMD} ${BERYLLIUM_FILES}/tools/prune-existing \
		${WRKSRC_helium}/utils ${WRKSRC} ${WRKSRC_helium}/pruning.list \
		${WRKDIR}/pruning.present.list

# Stage 2 is the framework's do-patch with files/patch-*.

post-patch:
	# from www/chromium
	patch -d ${WRKSRC}/typescript/tsc/internal/bundled/libs -Ep2 < \
		${WRKSRC}/third_party/typescript/linux-amd64/3pp/patches/typescript_native_preview.patch
	# Stages 3 and 4: Helium's series, then Beryllium's. Helium patches
	# that conflict with the BSD set are replaced by Beryllium's refreshed
	# copies (files/beryllium/helium-refresh, same relative paths); the
	# Helium distfile itself is never modified.
	${RM} -r ${WRKDIR}/helium-patches
	${CP} -R ${WRKSRC_helium}/patches ${WRKDIR}/helium-patches
	if [ -d ${BERYLLIUM_FILES}/helium-refresh ]; then \
		${CP} -R ${BERYLLIUM_FILES}/helium-refresh/ ${WRKDIR}/helium-patches/; \
	fi
	cd ${WRKSRC_helium} && ${SETENV} PATCH_BIN=gpatch ${PYTHON_CMD} \
		utils/patches.py apply ${WRKSRC} ${WRKDIR}/helium-patches \
		${BERYLLIUM_FILES}/patches
	# Stage 5: domain substitution
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/domain_substitution.py apply \
		-r domain_regex.list -f domain_substitution.list \
		-c ${WRKDIR}/domsubcache.tar.gz ${WRKSRC}
	# Stage 6: Helium's name substitution and translations, then
	# Beryllium's rename of the result (Helium -> Beryllium, beryllium://)
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/name_substitution.py --sub \
		-t ${WRKSRC}
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/i18n_apply.py -t ${WRKSRC}
	${SETENV} ${HELIUM_ENV} ${PYTHON_CMD} \
		${BERYLLIUM_FILES}/tools/beryllium-name-substitution --sub -t ${WRKSRC}
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/helium_version.py \
		--tree ${WRKSRC_helium} --platform-tree ${BERYLLIUM_FILES} \
		--chromium-tree ${WRKSRC}
	# Helium's resources (its favicons are kept), then Beryllium's branding
	# over every Helium logo (branding/, generated from art set v2)
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/generate_resources.py \
		resources/generate_resources.txt resources
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/replace_resources.py \
		resources/helium_resources.txt resources ${WRKSRC}
	cd ${WRKSRC_helium} && ${PYTHON_CMD} utils/replace_resources.py \
		${BERYLLIUM_FILES}/branding/beryllium_resources.txt \
		${BERYLLIUM_FILES}/branding ${WRKSRC}

pre-configure:
	# from www/chromium, minus the PGO profile merge (Helium sets
	# chrome_pgo_phase=0)
	cd ${WRKSRC} && ${SETENV} ${CONFIGURE_ENV} ${PYTHON_CMD} \
		./build/linux/unbundle/replace_gn_files.py --system-libraries \
		dav1d flac fontconfig harfbuzz libdrm libpng \
		libusb libwebp libxml libxslt openh264 opus || ${FALSE}
	cd ${WRKSRC}/media/ffmpeg && \
		${PYTHON_CMD} scripts/build_ffmpeg.py freebsd ${FFMPEG_TARGET} \
		--config-only --branding=${FFMPEG_BRAND}
	cd ${FFMPEG_BDIR} && ${GMAKE} ffversion.h
	${MKDIR} ${FFMPEG_CDIR}
.for _e in config.h config.asm config_components.asm config_components.h libavcodec libavformat libavutil
	-${CP} -pR ${FFMPEG_BDIR}/${_e} ${FFMPEG_CDIR}
.endfor
	touch ${WRKDIR}/pulseaudio-${PULSEV}/src/pulse/version.h
	@${REINPLACE_CMD} -e 's|$${LOCALBASE}|${LOCALBASE}|g;s|$${MODCLANG_VERSION}|${LLVM_DEFAULT}|g' \
		${WRKSRC}/build/linux/strip_binary.gni \
		${WRKSRC}/build/rust/rust_bindgen.gni \
		${WRKSRC}/build/rust/rust_bindgen_generator.gni \
		${WRKSRC}/v8/BUILD.gn

pre-build:
	cd ${WRKSRC}/typescript/tsc && \
		${SETENV} ${MAKE_ENV} go build -v -p ${MAKE_JOBS_NUMBER} -mod=vendor ./cmd/tsgo && \
		ln -sf ${WRKSRC}/typescript/tsc/tsgo \
		${WRKSRC}/third_party/typescript/linux-amd64/src/lib/tsc

do-configure:
	(cd ${WRKSRC}/esbuild && \
		${LOCALBASE}/bin/node scripts/esbuild.js \
		/usr/local/bin/esbuild --neutral && \
		rm -rf ${WRKSRC}/third_party/devtools-frontend/src/node_modules/esbuild && \
		ln -sf ${WRKSRC}/esbuild/npm/esbuild \
		${WRKSRC}/third_party/devtools-frontend/src/node_modules/esbuild \
	)
	# GN: bootstrap, then generated and checked arguments
	${LN} -sf ${WRKSRC}/out/${BUILDTYPE}/gn ${WRKSRC}/buildtools/linux64/gn
	cd ${WRKSRC} && ${SETENV} ${CONFIGURE_ENV} CC=${CC} CXX=${CXX} LD=${CXX} \
		READELF=${READELF} AR=${AR} NM=${NM} ${PYTHON_CMD} \
		./tools/gn/bootstrap/bootstrap.py ${GN_BOOTSTRAP_FLAGS}
	${GNARGS_CMD} --format args.gn > ${WRKSRC}/out/${BUILDTYPE}/args.gn
	${GNARGS_CMD} --format json > ${WRKDIR}/gnargs.json
	cd ${WRKSRC} && ${SETENV} ${CONFIGURE_ENV} ./out/${BUILDTYPE}/gn \
		gen out/${BUILDTYPE}
	# Toolchain links, from www/chromium
	@${MKDIR} ${WRKSRC}/third_party/node/freebsd/node-freebsd/bin
	${LN} -sf ${LOCALBASE}/bin/node ${WRKSRC}/third_party/node/freebsd/node-freebsd/bin/node
	@${MKDIR} ${WRKSRC}/third_party/rust-toolchain/bin
	${LN} -sf ${LOCALBASE}/bin/rustc ${WRKSRC}/third_party/rust-toolchain/bin/rustc
	${LN} -sf ${LOCALBASE}/bin/esbuild ${WRKSRC}/third_party/devtools-frontend/src/third_party/esbuild/esbuild
	${LN} -sf ${LOCALBASE}/bin/gperf ${WRKSRC}/third_party/gperf/cipd/bin/gperf
	@${MKDIR} ${WRKSRC}/buildtools/freebsd
	${LN} -sf ${WRKSRC}/buildtools/linux64/clang-format ${WRKSRC}/buildtools/freebsd
	${LN} -sf ${WRKSRC}/out/${BUILDTYPE}/gn ${WRKSRC}/buildtools/freebsd
	${LN} -sf /usr/bin/strip ${WRKSRC}/buildtools/freebsd/strip

do-install:
	@${MKDIR} ${STAGEDIR}${DATADIR}
	${INSTALL_MAN} ${WRKSRC}/chrome/app/resources/manpage.1.in \
		${STAGEDIR}${PREFIX}/share/man/man1/beryllium.1
	@${SED} -i "" -e 's,\@\@PACKAGE\@\@,beryllium,g;s,\@\@MENUNAME\@\@,Beryllium,g' \
		${STAGEDIR}${PREFIX}/share/man/man1/beryllium.1
	# Desktop icons: Beryllium art set v2 (branding/chromium/hicolor)
.for s in ${BERYLLIUM_ICON_SIZES}
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/icons/hicolor/${s}x${s}/apps
	${INSTALL_DATA} ${BERYLLIUM_FILES}/branding/hicolor/${s}x${s}/apps/beryllium.png \
		${STAGEDIR}${PREFIX}/share/icons/hicolor/${s}x${s}/apps/beryllium.png
.endfor
	${INSTALL_DATA} ${WRKSRC}/out/${BUILDTYPE}/*.png ${STAGEDIR}${DATADIR}
	${INSTALL_DATA} ${WRKSRC}/out/${BUILDTYPE}/*.pak ${STAGEDIR}${DATADIR}
.for d in snapshot_blob.bin v8_context_snapshot.bin
	${INSTALL_DATA} ${WRKSRC}/out/${BUILDTYPE}/${d} ${STAGEDIR}${DATADIR}
.endfor
	${INSTALL_PROGRAM} ${WRKSRC}/out/${BUILDTYPE}/chrome \
		${STAGEDIR}${DATADIR}/beryllium
	cd ${WRKSRC}/out/${BUILDTYPE} && \
		${COPYTREE_SHARE} "locales resources" ${STAGEDIR}${DATADIR}
	@${MKDIR} ${STAGEDIR}${DESKTOPDIR}
	${INSTALL_DATA} ${WRKDIR}/beryllium.desktop ${STAGEDIR}${DESKTOPDIR}
	${INSTALL_SCRIPT} ${WRKDIR}/beryllium ${STAGEDIR}${PREFIX}/bin
	# ANGLE, EGL, Vulkan, SwiftShader
.for f in libEGL.so libGLESv2.so libVkICD_mock_icd.so libvk_swiftshader.so
	${INSTALL_LIB} ${WRKSRC}/out/${BUILDTYPE}/${f} ${STAGEDIR}${DATADIR}
.endfor
	${INSTALL_LIB} ${WRKSRC}/out/${BUILDTYPE}/libvulkan.so.1 \
		${STAGEDIR}${DATADIR}/libvulkan.so
	${INSTALL_DATA} ${WRKSRC}/out/${BUILDTYPE}/vk_swiftshader_icd.json ${STAGEDIR}${DATADIR}
.if ${BUILDTYPE} == Debug
	${INSTALL_LIB} ${WRKSRC}/out/${BUILDTYPE}/libVkLayer_khronos_validation.so ${STAGEDIR}${DATADIR}
.endif
	# Provenance and hardening record (plan/04 section 3, RT-09)
	${PYTHON_CMD} ${BERYLLIUM_FILES}/tools/build-manifest \
		--gnargs-json ${WRKDIR}/gnargs.json \
		--imported-from ${FILESDIR}/IMPORTED-FROM \
		--version ${DISTVERSION} --chromium ${CHROMIUM_VERSION} \
		--helium-commit ${HELIUM_COMMIT} \
		--patches-dir ${BERYLLIUM_FILES}/patches \
		> ${STAGEDIR}${DATADIR}/BUILD-MANIFEST.json

post-install-DEBUG-on:
	${INSTALL_LIB} ${WRKSRC}/out/${BUILDTYPE}/*.so \
		${STAGEDIR}${DATADIR}
	${INSTALL_PROGRAM} ${WRKSRC}/out/${BUILDTYPE}/character_data_generator \
		${STAGEDIR}${DATADIR}

# Helium's ungoogled-chromium/fix-building-with-prunned-binaries.patch
# disables the Linux strip_binary branch of chrome/test/chromedriver/BUILD.gn,
# so chromedriver is linked directly as "chromedriver" (as in
# www/ungoogled-chromium), not "chromedriver.unstripped" (www/chromium).
post-install-DRIVER-on:
	${INSTALL_PROGRAM} ${WRKSRC}/out/${BUILDTYPE}/chromedriver \
		${STAGEDIR}${PREFIX}/bin/beryllium-chromedriver

.include <bsd.port.post.mk>
