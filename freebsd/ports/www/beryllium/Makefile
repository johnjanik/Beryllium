# Beryllium: a privacy-focused Chromium-based browser for FreeBSD.
#
# Derived from FreeBSD ports www/chromium (156.0.8078.47_1, ports commit
# 6ad3e0c8) and the Helium-style source pipeline (plan/04, plan/05):
#   stage 0  extract Google's official -lite tarball and Helium's deps
#   stage 1  prune prebuilt binaries          (pre-patch)
#   stage 2  imported BSD patches, files/patch-*   (do-patch)
#   stage 3  Helium series                     (post-patch)
#   stage 4  Beryllium series                  (post-patch)
#   stage 5  domain substitution               (post-patch)
#   stage 6  name substitution, translations, version, resources (post-patch)
# GN arguments are generated by gnargs-from-flags from Helium's flags.gn and
# flags.freebsd.gn, with the privacy-key guard (plan/07 section 2).
#
# Phase 1 port: no sandbox claims (same as www/chromium: none).
# Files under files/beryllium/ and Makefile.helium are generated by
# freebsd/tools/sync-port; do not edit them here.

PORTNAME=	beryllium
.include "${.PARSEDIR}/Makefile.helium"
DISTVERSION=	${HELIUM_VERSION}.${BERYLLIUM_REVISION}
PULSEMV=	16
PULSEV=		${PULSEMV}.1
TSV=		7.0.2
CATEGORIES=	www wayland
MASTER_SITES=	https://commondatastorage.googleapis.com/chromium-browser-official/:chromium \
		https://nerd.hu/distfiles/:external \
		https://freedesktop.org/software/pulseaudio/releases/:pulseaudio \
		https://github.com/imputnet/helium-onboarding/releases/download/${ONBOARDING_VERSION}/:onboarding \
		https://github.com/imputnet/uBlock/releases/download/${UBLOCK_VERSION}/:ublock \
		https://github.com/imputnet/helium-nonfree-assets/releases/download/${SEARCHDATA_VERSION}/:searchdata
DISTFILES=	chromium-${CHROMIUM_VERSION}-lite.tar.xz:chromium \
		pulseaudio-${PULSEV}.tar.gz:pulseaudio \
		TypeScript-${TSV}-vendor.tar.gz:external \
		helium-onboarding-${ONBOARDING_VERSION}.tar.gz:onboarding \
		uBlock0_${UBLOCK_VERSION}.chromium.zip:ublock
# Helium's dependencies are unpacked into the tree by hand (post-extract),
# like Helium's own utils/downloads.py does, not by the framework.
EXTRACT_ONLY=	${_DISTFILES:Nhelium-onboarding-*:NuBlock0_*:Nnonfree-search-engines-data-*}

USE_GITHUB=	nodefault
