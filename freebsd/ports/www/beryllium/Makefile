# Option-driven GN arguments. Everything else comes from Helium's flags.gn
# and flags.freebsd.gn through gnargs-from-flags, which refuses any
# privacy-tagged key from here (plan/07 section 2).
GN_BOOTSTRAP_FLAGS=	--no-clean --no-rebuild --skip-generate-buildfiles

SUB_FILES=	beryllium beryllium.desktop pkg-message
SUB_LIST+=	COMMENT="${COMMENT}"

OPTIONS_DEFINE=		CODECS CUPS DEBUG DRIVER KERBEROS LTO PIPEWIRE SEARCHICONS WIDEVINE
OPTIONS_DEFAULT=	CODECS CUPS DRIVER KERBEROS PIPEWIRE SEARCHICONS SNDIO ALSA PULSEAUDIO
OPTIONS_GROUP=		AUDIO
OPTIONS_GROUP_AUDIO=	ALSA PULSEAUDIO SNDIO
OPTIONS_RADIO=		KERBEROS
OPTIONS_RADIO_KERBEROS=	HEIMDAL HEIMDAL_BASE MIT
OPTIONS_SUB=		yes
CODECS_DESC=		Compile and enable patented codecs like H.264
DRIVER_DESC=		Install beryllium-chromedriver
HEIMDAL_BASE_DESC=	Heimdal Kerberos (base)
HEIMDAL_DESC=		Heimdal Kerberos (security/heimdal)
MIT_DESC=		MIT Kerberos (security/krb5)
SEARCHICONS_DESC=	Search engine icons from helium-nonfree-assets (licence under review, plan/10 Q5)

ALSA_LIB_DEPENDS=	libasound.so:audio/alsa-lib
ALSA_RUN_DEPENDS=	${LOCALBASE}/lib/alsa-lib/libasound_module_pcm_oss.so:audio/alsa-plugins \
			alsa-lib>=1.1.1_1:audio/alsa-lib
ALSA_VARS=		GN_OPTION_ARGS+=use_alsa=true
ALSA_VARS_OFF=		GN_OPTION_ARGS+=use_alsa=false

CODECS_VARS=		GN_OPTION_ARGS+=proprietary_codecs=true \
			GN_OPTION_ARGS+=ffmpeg_branding="Chrome" \
			FFMPEG_BRAND="Chrome"
CODECS_VARS_OFF=	GN_OPTION_ARGS+=proprietary_codecs=false \
			GN_OPTION_ARGS+=ffmpeg_branding="Chromium" \
			FFMPEG_BRAND="Chromium"

CUPS_LIB_DEPENDS=	libcups.so:print/cups
CUPS_VARS=		GN_OPTION_ARGS+=use_cups=true
CUPS_VARS_OFF=		GN_OPTION_ARGS+=use_cups=false

DEBUG_VARS=		BUILDTYPE=Debug \
			GN_OPTION_ARGS+=is_debug=true \
			GN_OPTION_ARGS+=is_component_build=false \
			GN_OPTION_ARGS+=symbol_level=1 \
			GN_BOOTSTRAP_FLAGS+=--debug \
			WANTSPACE="60 GB" \
			WANTMEM="32 GB"
