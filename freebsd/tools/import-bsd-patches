#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Import the BSD patch set from a FreeBSD ports checkout (plan/05 section 5).

  import-bsd-patches import --ports <ports checkout> [--port www/chromium]
  import-bsd-patches check

`import` replaces freebsd/ports/www/beryllium/files/patch-* with the
patch-* files of the given port, never editing them (plan/05 rule 1), and
writes:

  files/IMPORTED-FROM     ports commit, port version, date, counts
  BSD-PATCH-REVIEW.md     every imported patch on a security-review path
                          (RT-10), marked new, changed or unchanged since the
                          previous import, with its sha256

`check` lists security-path patches whose current sha256 has no entry in
freebsd/ports/www/beryllium/bsd-patch-reviews.json (reviewer, date, notes).
It exits non-zero only with --strict, so CI can report the review debt now
and enforce it once the first full review is done.
"""

import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
PORT_DIR = os.path.join(REPO, "freebsd", "ports", "www", "beryllium")
FILES_DIR = os.path.join(PORT_DIR, "files")
REVIEW_MD = os.path.join(PORT_DIR, "BSD-PATCH-REVIEW.md")
REVIEWS_JSON = os.path.join(PORT_DIR, "bsd-patch-reviews.json")
PROVENANCE = os.path.join(FILES_DIR, "IMPORTED-FROM")

_loader = importlib.machinery.SourceFileLoader(
    "patchmatrix", os.path.join(HERE, "patch-matrix"))
_spec = importlib.util.spec_from_loader("patchmatrix", _loader)
pm = importlib.util.module_from_spec(_spec)
_loader.exec_module(pm)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        h.update(f.read())
    return h.hexdigest()


def gated_paths(patch_path):
    with open(patch_path, encoding="utf-8", errors="replace") as f:
        return sorted(p for p in pm.parse_patch(f.read()) if pm.is_security_path(p))


def current_patches():
    if not os.path.isdir(FILES_DIR):
        return {}
    return {n: sha256(os.path.join(FILES_DIR, n))
            for n in os.listdir(FILES_DIR) if n.startswith("patch-")}


def port_version(port_path):
    text = open(os.path.join(port_path, "Makefile"), encoding="utf-8").read()
    v = re.search(r"^PORTVERSION=\s*(\S+)", text, re.M)
    r = re.search(r"^PORTREVISION=\s*(\S+)", text, re.M)
    return (v.group(1) if v else "?") + (f"_{r.group(1)}" if r else "")


def do_import(ports, port):
    src = os.path.join(ports, port, "files")
    names = sorted(n for n in os.listdir(src) if n.startswith("patch-"))
    before = current_patches()
    os.makedirs(FILES_DIR, exist_ok=True)
    for old in before:
        if old not in names:
            os.unlink(os.path.join(FILES_DIR, old))
    for n in names:
        shutil.copyfile(os.path.join(src, n), os.path.join(FILES_DIR, n))
    after = current_patches()

    commit = subprocess.run(["git", "-C", ports, "rev-parse", "HEAD"],
                            capture_output=True, text=True, check=True).stdout.strip()
    added = sorted(set(after) - set(before))
    removed = sorted(set(before) - set(after))
    changed = sorted(n for n in after if n in before and before[n] != after[n])
    with open(PROVENANCE, "w", encoding="utf-8") as f:
        f.write(f"ports_commit: {commit}\n")
        f.write(f"port: {port} {port_version(os.path.join(ports, port))}\n")
        f.write(f"imported: {datetime.date.today().isoformat()}\n")
        f.write(f"patches: {len(after)} (added {len(added)}, changed {len(changed)}, "
                f"removed {len(removed)})\n")
        f.write("openbsd_ports_commit: none (FreeBSD set used directly)\n")

    rows = []
    for n in names:
        paths = gated_paths(os.path.join(FILES_DIR, n))
        if not paths:
            continue
        status = "new" if n in added else "changed" if n in changed else "unchanged"
        rows.append((n, status, after[n], paths))
    with open(REVIEW_MD, "w", encoding="utf-8") as f:
        f.write("# BSD patches on security-review paths\n\n")
        f.write("Generated by `freebsd/tools/import-bsd-patches`; do not edit by hand. "
                "Record reviews in `bsd-patch-reviews.json` (plan/12 RT-10).\n\n")
        f.write(f"Import: ports commit `{commit}`, {port} "
                f"{port_version(os.path.join(ports, port))}. "
                f"{len(rows)} of {len(names)} patches touch a security-review path.\n\n")
        f.write("| Patch | Since last import | sha256 | Paths |\n|---|---|---|---|\n")
        for n, status, digest, paths in rows:
            f.write(f"| `{n}` | {status} | `{digest[:16]}` | "
                    + ", ".join(f"`{p}`" for p in paths) + " |\n")
    print(f"imported {len(after)} patches from {port} at {commit[:12]}: "
          f"{len(added)} added, {len(changed)} changed, {len(removed)} removed; "
          f"{len(rows)} on security-review paths")
    return 0


def do_check(strict):
    reviews = {}
    if os.path.exists(REVIEWS_JSON):
        with open(REVIEWS_JSON, encoding="utf-8") as f:
            reviews = {k: v for k, v in json.load(f).items() if not k.startswith("_")}
    missing = []
    for n, digest in sorted(current_patches().items()):
        if not gated_paths(os.path.join(FILES_DIR, n)):
            continue
        entry = reviews.get(n)
        if not entry or entry.get("sha256") != digest:
            missing.append(n)
    if missing:
        print(f"import-bsd-patches: {len(missing)} security-path BSD patches have "
              f"no review for their current content:")
        for n in missing:
            print(f"  {n}")
    else:
        print("import-bsd-patches: every security-path BSD patch is reviewed")
    return 1 if (missing and strict) else 0


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("import")
    i.add_argument("--ports", required=True)
    i.add_argument("--port", default="www/chromium")
    c = sub.add_parser("check")
    c.add_argument("--strict", action="store_true")
    a = p.parse_args(argv)
    if a.cmd == "import":
        return do_import(a.ports, a.port)
    return do_check(a.strict)


if __name__ == "__main__":
    sys.exit(main())
