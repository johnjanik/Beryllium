#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Make freebsd/ports/www/beryllium self-contained for Poudriere.

A Poudriere overlay port sees only its own directory, not the rest of this
repository. This copies Beryllium's build inputs (tools, patches, refreshes and
branding) into the port's files/beryllium/ and writes Makefile.helium (the Helium commit, versions
and dependency pins, read from the helium submodule), so the submodule
stays the single source of truth.

  sync-port          update the port
  sync-port --check  exit 1 if the port is out of date (CI)
"""

import argparse
import configparser
import filecmp
import hashlib
import os
import re
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
PORT = os.path.join(REPO, "freebsd", "ports", "www", "beryllium")
DEST = os.path.join(PORT, "files", "beryllium")

COPIES = {
    "flags.freebsd.gn": "flags.freebsd.gn",
    "revision.txt": "revision.txt",
    "freebsd/privacy/gn-privacy-keys.json": "gn-privacy-keys.json",
    "freebsd/tools/gnargs-from-flags": "tools/gnargs-from-flags",
    "freebsd/tools/beryllium-name-substitution": "tools/beryllium-name-substitution",
    "freebsd/tools/prune-existing": "tools/prune-existing",
    "freebsd/tools/build-manifest": "tools/build-manifest",
}


def read(path):
    with open(os.path.join(REPO, path), encoding="utf-8") as f:
        return f.read().strip()


def makefile_helium():
    helium = os.path.join(REPO, "helium")
    commit = subprocess.run(["git", "-C", helium, "rev-parse", "HEAD"],
                            capture_output=True, text=True, check=True).stdout.strip()
    chromium = read("helium/chromium_version.txt")
    major = int(chromium.split(".")[0])
    version = f"{read('helium/version.txt')}.{major - 136}.{read('helium/revision.txt')}"
    deps = configparser.ConfigParser(interpolation=None)
    deps.read(os.path.join(helium, "deps.ini"))
    return (
        "# Generated by freebsd/tools/sync-port from the helium submodule.\n"
        "# Do not edit; move the submodule and run sync-port instead.\n"
        f"HELIUM_COMMIT=\t\t{commit}\n"
        f"HELIUM_VERSION=\t\t{version}\n"
        f"CHROMIUM_VERSION=\t{chromium}\n"
        f"BERYLLIUM_REVISION=\t{read('revision.txt')}\n"
        f"ONBOARDING_VERSION=\t{deps['onboarding']['version']}\n"
        f"UBLOCK_VERSION=\t\t{deps['ublock_origin']['version']}\n"
        f"SEARCHDATA_VERSION=\t{deps['search_engines_data']['version']}\n"
    )


def series_files():
    out = ["series"]
    with open(os.path.join(REPO, "patches", "series"), encoding="utf-8") as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                out.append(line)
    return out


REFRESH = os.path.join(REPO, "patches", "helium-refresh")
ORIGINAL_RE = re.compile(r"^Original sha256: ([0-9a-f]{64})$", re.M)


def refresh_files():
    """Beryllium's refreshed copies of Helium patches (relative paths)."""
    out = []
    for root, _, files in os.walk(REFRESH):
        for name in files:
            out.append(os.path.relpath(os.path.join(root, name), REFRESH))
    return sorted(out)


def stale_refreshes():
    """Refreshes whose Helium original changed since they were written."""
    problems = []
    for rel in refresh_files():
        with open(os.path.join(REFRESH, rel), encoding="utf-8") as f:
            m = ORIGINAL_RE.search(f.read())
        original = os.path.join(REPO, "helium", "patches", rel)
        if not os.path.exists(original):
            problems.append(f"{rel}: no longer in Helium's patches")
            continue
        with open(original, "rb") as f:
            digest = hashlib.sha256(f.read()).hexdigest()
        if not m:
            problems.append(f"{rel}: missing 'Original sha256:' header")
        elif m.group(1) != digest:
            problems.append(f"{rel}: Helium changed this patch; redo the refresh")
    return problems


BRANDING = os.path.join(REPO, "branding")


ICONS = os.path.join(REPO, "artwork", "icons")


def branding_files():
    """{port path: source}: Chromium branding files and the app icons."""
    out = {}
    chromium = os.path.join(BRANDING, "chromium")
    for root, _, files in os.walk(chromium):
        for name in files:
            src = os.path.join(root, name)
            out[os.path.join("branding", os.path.relpath(src, chromium))] = src
    for name in os.listdir(ICONS):
        out[os.path.join("branding", "icons", name)] = os.path.join(ICONS, name)
    return out


def plan():
    """Return {dest_relpath: (source_abspath or None, content or None)}."""
    items = {}
    for dst, src in branding_files().items():
        items[dst] = (src, None)
    for src, dst in COPIES.items():
        items[dst] = (os.path.join(REPO, src), None)
    for rel in series_files():
        items[os.path.join("patches", rel)] = (os.path.join(REPO, "patches", rel), None)
    for rel in refresh_files():
        items[os.path.join("helium-refresh", rel)] = (os.path.join(REFRESH, rel), None)
    return items


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--check", action="store_true")
    a = p.parse_args(argv)

    problems = stale_refreshes()
    if problems:
        print("sync-port: Beryllium refreshes of Helium patches need attention:")
        for msg in problems:
            print(f"  {msg}")
        return 1

    items = plan()
    mk = makefile_helium()
    stale = []
    mk_path = os.path.join(PORT, "Makefile.helium")
    if not os.path.exists(mk_path) or open(mk_path, encoding="utf-8").read() != mk:
        stale.append("Makefile.helium")
    for dst, (src, _) in items.items():
        target = os.path.join(DEST, dst)
        if not os.path.exists(target) or not filecmp.cmp(src, target, shallow=False):
            stale.append(os.path.join("files/beryllium", dst))
    existing = set()
    for root, _, files in os.walk(DEST):
        for name in files:
            existing.add(os.path.relpath(os.path.join(root, name), DEST))
    extra = sorted(existing - set(items))
    stale += [os.path.join("files/beryllium", e) + " (no longer an input)" for e in extra]

    if a.check:
        if stale:
            print("sync-port: the port is out of date; run freebsd/tools/sync-port:")
            for s in stale:
                print(f"  {s}")
            return 1
        print("sync-port: port inputs are up to date")
        return 0

    with open(mk_path, "w", encoding="utf-8") as f:
        f.write(mk)
    for dst, (src, _) in items.items():
        target = os.path.join(DEST, dst)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copy2(src, target)
    for e in extra:
        os.unlink(os.path.join(DEST, e))
    print(f"sync-port: updated {len(stale)} file(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
