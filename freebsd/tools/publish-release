#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# Publish Beryllium packages as a GitHub release, in the layout install.sh
# expects. Run it on the build machine, from the repository, after a
# Poudriere build:
#
#   freebsd/tools/publish-release [--draft] [--dry-run] [--key FILE] TAG PACKAGE...
#
#   freebsd/tools/publish-release v0.20.3.19 \
#       /usr/local/poudriere/data/packages/160amd64-default/All/beryllium-0.20.3.19.pkg
#
# Each package is renamed beryllium-FreeBSD-<major>-amd64.pkg after the ABI
# it was built for (the names stay the same from release to release, so
# install.sh can use .../releases/latest/download/<name>).
#
# Signing (plan/18 section 5; freebsd/release-keys/README.md): RELEASE
# names the release (version, tag, commit, date) and lists the SHA-256 of
# every file in it, and RELEASE.sig is its signature, made with the key in
# ~/.ssh/beryllium-release (or --key FILE, or BERYLLIUM_RELEASE_KEY; a
# hardware token's key file works the same). A release is not published
# without it. Before anything is uploaded, this checkout's install.sh
# verifies what was made (install.sh --verify-only), and after the upload
# it verifies what GitHub serves. SHA256SUMS is still written, for older
# copies of install.sh and for checking by hand.
#
# The release is created with the GitHub CLI (gh) at the
# current commit, which must already be pushed: that commit, with the
# distfiles pinned in freebsd/ports/www/beryllium/distinfo, is the
# corresponding source of the packages (GPL-3.0). Without gh, the files
# and notes are left in a directory for upload through the web page.
#
# Provenance (plan/16 BER-06): every package carries the BUILD-MANIFEST.json
# the port wrote when it was built (version, Chromium and Helium versions,
# the imported BSD patch set, the SHA-256 of every Beryllium patch).
# check-provenance compares it with this checkout and the package's own
# version; a package built from other inputs is refused, so the release
# never names a commit the package was not built from. The manifests are
# published with the release as BUILD-MANIFEST-FreeBSD-<major>-amd64.json.
#
# A release is a clean build (plan/04): a package whose manifest says it was
# built with a compiler cache (install.sh --build --ccache) is refused.

set -eu

DRAFT=""
DRYRUN=0
KEY="${BERYLLIUM_RELEASE_KEY:-${HOME:-/root}/.ssh/beryllium-release}"
while [ $# -gt 0 ]; do
	case "$1" in
	--draft) DRAFT=--draft ;;
	--dry-run) DRYRUN=1 ;;
	--key) shift; KEY=${1:?--key needs a file} ;;
	--help | -h) sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
	-*) echo "publish-release: unknown option $1" >&2; exit 1 ;;
	*) break ;;
	esac
	shift
done
[ $# -ge 2 ] || { echo "usage: publish-release [--draft] [--dry-run] [--key FILE] TAG PACKAGE..." >&2; exit 1; }
TAG=$1
shift

die() { echo "publish-release: $*" >&2; exit 1; }
# The tag goes into the signed manifest, where install.sh accepts this shape only.
case "$TAG" in
v[0-9]*) ;;
*) die "the tag must look like v0.20.3.19 (got '$TAG')" ;;
esac
case "$TAG" in
*[!0-9A-Za-z._-]*) die "the tag may hold letters, digits, dots, hyphens and underscores only (got '$TAG')" ;;
esac
command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen is needed to sign the release"
[ -f "$KEY" ] || die "no release signing key at $KEY (--key FILE, or BERYLLIUM_RELEASE_KEY); a release is not published unsigned. freebsd/release-keys/README.md says which keys sign releases"
TOOLS=$(cd "$(dirname "$0")" && pwd)

# manifest_of PACKAGE OUTFILE: the package's BUILD-MANIFEST.json. pkg stores
# paths with their leading slash; bsdtar lists and matches them as stored,
# GNU tar after removing the slash, so both spellings are tried.
manifest_of() {
	member=$(tar -tf "$1" 2>/dev/null | grep -m1 -E '(^|/)BUILD-MANIFEST\.json$') || return 1
	tar -xOf "$1" "$member" >"$2" 2>/dev/null || tar -xOf "$1" "${member#/}" >"$2" 2>/dev/null
}

REPO_ROOT=$(git rev-parse --show-toplevel)
COMMIT=$(git -C "$REPO_ROOT" rev-parse HEAD)
[ -z "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=no)" ] ||
	die "the checkout has uncommitted changes; the release must match a commit"
[ -n "$(git -C "$REPO_ROOT" branch -r --contains "$COMMIT")" ] ||
	die "commit $COMMIT is not on GitHub yet; push it first"

OUT=$(mktemp -d "${TMPDIR:-/tmp}/beryllium-release.XXXXXX")
names=""
version=""
for pkgfile in "$@"; do
	[ -f "$pkgfile" ] || die "no such file: $pkgfile"
	name=$(pkg query -F "$pkgfile" '%n')
	[ "$name" = beryllium ] || die "$pkgfile is $name, not beryllium"
	v=$(pkg query -F "$pkgfile" '%v')
	[ -z "$version" ] || [ "$version" = "$v" ] ||
		die "packages have different versions ($version, $v)"
	version=$v
	abi=$(pkg query -F "$pkgfile" '%q')
	case "$abi" in
	FreeBSD:*:amd64) ;;
	*) die "$pkgfile is for $abi; only FreeBSD amd64 packages are published" ;;
	esac
	major=$(echo "$abi" | cut -d: -f2)
	asset="beryllium-FreeBSD-${major}-amd64.pkg"
	case " $names " in *" $asset "*) die "two packages for FreeBSD $major" ;; esac
	manifest="BUILD-MANIFEST-FreeBSD-${major}-amd64.json"
	manifest_of "$pkgfile" "$OUT/$manifest" ||
		die "$pkgfile carries no BUILD-MANIFEST.json; it was not built by www/beryllium"
	rc=0
	python3 "$TOOLS/check-provenance" --repo "$REPO_ROOT" --version "$v" "$OUT/$manifest" || rc=$?
	case "$rc" in
	0) ;;
	3) die "$pkgfile was built with a compiler cache: it is a test build. Build the release without one (install.sh --build, without --ccache)" ;;
	*) die "$pkgfile was not built from this checkout (commit $COMMIT); build it from here, or check out what it was built from" ;;
	esac
	cp "$pkgfile" "$OUT/$asset"
	names="$names $asset"
	manifests="${manifests:-} $manifest"
done

(cd "$OUT" && for f in $names; do sha256 -r "$f"; done) >"$OUT/SHA256SUMS"

# The signed manifest: which release this is, and the digest of every file.
{
	echo "beryllium-release 1"
	echo "version $version"
	echo "tag $TAG"
	echo "commit $COMMIT"
	echo "date $(date -u +%Y-%m-%d)"
	for f in $names $manifests; do
		printf 'sha256 %s  %s\n' "$(sha256 -q "$OUT/$f")" "$f"
	done
} >"$OUT/RELEASE"
rm -f "$OUT/RELEASE.sig"
ssh-keygen -Y sign -f "$KEY" -n beryllium-release "$OUT/RELEASE" ||
	die "could not sign the release manifest with $KEY; nothing was published"
[ -s "$OUT/RELEASE.sig" ] || die "ssh-keygen wrote no signature; nothing was published"
# The installer users will run must accept it: its own key list, its own
# checks, on the files as they are about to be uploaded.
echo "publish-release: verifying what was made with this checkout's install.sh"
sh "$REPO_ROOT/install.sh" --verify-only --release "$TAG" --from "file://$OUT" ||
	die "install.sh does not accept the signed release in $OUT (is the key that signed it in freebsd/release-keys/allowed_signers and in install.sh, in its validity, and not withdrawn?); nothing was published"
signed_by=$(ssh-keygen -Y verify -f "$REPO_ROOT/freebsd/release-keys/allowed_signers" \
	-I release@beryllium -n beryllium-release -s "$OUT/RELEASE.sig" <"$OUT/RELEASE" |
	sed -n 's/.* key \(SHA256:[A-Za-z0-9+\/=]*\).*/\1/p')
[ -n "$signed_by" ] || die "the key that signed the release is not in freebsd/release-keys/allowed_signers; nothing was published"

chromium=$(cat "$REPO_ROOT/helium/chromium_version.txt")
# shellcheck disable=SC2016 # the backticks are Markdown, not command substitution
cat >"$OUT/NOTES.md" <<EOF
Beryllium $version (Chromium $chromium) for FreeBSD amd64.

**Development build: no sandbox yet.** By default no Beryllium process is
confined; a compromised web page is not contained. The README describes
an experimental, opt-in renderer lockdown, not yet a complete sandbox.

Install: download \`install.sh\` from the repository, read it, and run
\`sh install.sh\`; it picks the package for your FreeBSD version, verifies
the release's signature and installs nothing that fails it.

Signed: \`RELEASE\` names this release and lists the SHA-256 of each file
in it; \`RELEASE.sig\` is its signature, made with the release key
\`$signed_by\`. \`sh install.sh --verify-only\` checks both and the
package without installing; \`freebsd/release-keys/README.md\` in the
repository has the key list and the commands to check by hand.

What works, what was checked and on what hardware, the sandbox status
of each process and the known issues: the Status section of README.md at
commit $COMMIT.

Packages:$(for f in $names; do printf '\n- `%s`' "$f"; done)

Corresponding source: commit $COMMIT of this repository (with its \`helium\`
submodule), and the distfiles pinned in
\`freebsd/ports/www/beryllium/distinfo\`. Each package's
\`BUILD-MANIFEST-FreeBSD-<version>-amd64.json\` (also inside the package as
\`/usr/local/share/beryllium/BUILD-MANIFEST.json\`) records the inputs it was
built from, checked against this commit before publishing. The software is
GPL-3.0; the artwork is CC BY 4.0; the Beryllium name and logo are reserved
(TRADEMARKS.md).
EOF

echo "publish-release: release files in $OUT, signed with $signed_by:"
ls -l "$OUT"
cat "$OUT/RELEASE"

if [ "$DRYRUN" = 1 ]; then
	echo "+ gh release create $TAG --target $COMMIT --title \"Beryllium $version\" --notes-file $OUT/NOTES.md $DRAFT $OUT/RELEASE $OUT/RELEASE.sig $OUT/SHA256SUMS$(for f in $names $manifests; do printf ' %s' "$OUT/$f"; done)"
	exit 0
fi
if ! command -v gh >/dev/null 2>&1; then
	cat <<EOF

GitHub CLI (gh) not found (pkg install gh). To publish by hand, create a
release with tag $TAG on commit $COMMIT at
https://github.com/johnjanik/Beryllium/releases/new, paste NOTES.md as the
description, and attach RELEASE, RELEASE.sig, SHA256SUMS, the .pkg files
and the BUILD-MANIFEST files from $OUT. Then check what was published:
  sh install.sh --verify-only --release $TAG
EOF
	exit 0
fi
# gh finds the GitHub repository from the git checkout it runs in, so run it
# in the repository and name the release files by their full paths (each is
# uploaded under its own file name).
set -- "$OUT/RELEASE" "$OUT/RELEASE.sig" "$OUT/SHA256SUMS"
for f in $names $manifests; do
	set -- "$@" "$OUT/$f"
done
# shellcheck disable=SC2086 # DRAFT is empty or one flag
(cd "$REPO_ROOT" && gh release create "$TAG" --target "$COMMIT" \
	--title "Beryllium $version" --notes-file "$OUT/NOTES.md" $DRAFT "$@")

# The round trip: what GitHub now serves must verify too. A draft's files
# are not served until it is published.
if [ -n "$DRAFT" ]; then
	echo "publish-release: a draft; once it is published, check it: sh install.sh --verify-only --release $TAG"
	exit 0
fi
echo "publish-release: verifying what was published"
sh "$REPO_ROOT/install.sh" --verify-only --release "$TAG" ||
	die "the release was published, and what GitHub serves for $TAG does NOT verify. Take it down (gh release delete $TAG) or replace its files, and find out why before publishing again"
echo "publish-release: $TAG is published and verifies"
