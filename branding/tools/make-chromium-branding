       ("product_logo_white_200.png", "components/resources/default_200_percent/chromium/product_logo_white.png"),
       ("product_logo_name_22.png", "chrome/app/theme/default_100_percent/chromium/product_logo_name_22.png"),
       ("product_logo_name_22_white.png", "chrome/app/theme/default_100_percent/chromium/product_logo_name_22_white.png"),
       ("product_logo_name_22_200.png", "chrome/app/theme/default_200_percent/chromium/product_logo_name_22.png"),
       ("product_logo_name_22_white_200.png", "chrome/app/theme/default_200_percent/chromium/product_logo_name_22_white.png"),
