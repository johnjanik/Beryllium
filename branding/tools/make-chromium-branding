       ("icons/beryllium-64.png", "chrome/app/theme/default_200_percent/chromium/product_logo_32.png"),
       ("icons/beryllium-16.png", "chrome/app/theme/default_100_percent/chromium/linux/product_logo_16.png"),
       ("icons/beryllium-32.png", "chrome/app/theme/default_100_percent/chromium/linux/product_logo_32.png"),
