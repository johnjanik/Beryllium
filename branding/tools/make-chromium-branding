GENERATED_NOTE = ("Generated by branding/tools/make-chromium-branding from the "
                  "Beryllium art set v2. Do not edit by hand.")

# ----------------------------------------------------------------------------
# Glyph geometry, in orb radii, origin at the orb centre, y down. Measured on
# artwork/logo/beryllium-orb.png: "Be" is about 0.7 radii tall, 1.1 wide, centred.

LETTER_CAP_HEIGHT = 0.68   # of the orb radius
LETTER_TRACKING = -0.02    # em
GLYPH_EXTENT = (-1.0, -1.0, 1.0, 1.0)  # x0, y0, x1, y1 in orb radii


class _Collect(BasePen):
    def __init__(self, glyphset):
        super().__init__(glyphset)
        self.contours, self.cur = [], None

    def _moveTo(self, p):
        self.cur = [("M", p)]

    def _lineTo(self, p):
        self.cur.append(("L", p))

    def _curveToOne(self, a, b, c):
        self.cur.append(("C", a, b, c))

    def _closePath(self):
        self.cur.append(("Z",))
        self.contours.append(self.cur)
        self.cur = None

    _endPath = _closePath


def letter_contours(font_path, text="Be"):
    """'Be' outlines in orb radii, centred on the orb, y down."""
    font = TTFont(font_path)
    gs = font.getGlyphSet()
    cmap = font.getBestCmap()
    upem = font["head"].unitsPerEm
    cap = getattr(font["OS/2"], "sCapHeight", 0) or 0.73 * upem
    contours, x = [], 0.0
    for ch in text:
        name = cmap[ord(ch)]
        pen = _Collect(gs)
        gs[name].draw(pen)
        for c in pen.contours:
            contours.append([(op, *[(px + x, py) for px, py in pts]) for op, *pts in c])
        x += gs[name].width + LETTER_TRACKING * upem
    s = LETTER_CAP_HEIGHT / cap
    pts = [p for c in contours for _, *ps in c for p in ps]
    x0, x1 = min(p[0] for p in pts), max(p[0] for p in pts)
    y0, y1 = min(p[1] for p in pts), max(p[1] for p in pts)
    cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
    return [[(op, *[((px - cx) * s, -(py - cy) * s) for px, py in ps]) for op, *ps in c]
            for c in contours]


class Glyph:
    """The plain orb with "Be", placed on a square canvas."""

    def __init__(self, font_path, canvas=256, margin=8):
        x0, y0, x1, y1 = GLYPH_EXTENT
        self.canvas = canvas
        self.r = (canvas - 2 * margin) / max(x1 - x0, y1 - y0)
        self.cx = canvas / 2 - (x0 + x1) / 2 * self.r
        self.cy = canvas / 2 - (y0 + y1) / 2 * self.r
        self.letters = [self.place(c) for c in letter_contours(font_path)]

    def place(self, contour):
        return [(op, *[(self.cx + x * self.r, self.cy + y * self.r) for x, y in pts])
                for op, *pts in contour]

    # Layers: (name, colour or None for "current colour", items). An item is
    # a contour or ("circle", cx, cy, r). Within a layer the fill is even-odd.
    def layers(self, color):
        orb = ("circle", self.cx, self.cy, self.r)
        if not color:
            return [("orb with letters cut out", None, [orb] + self.letters)]
        inner = ("circle", self.cx, self.cy, self.r * 0.93)
        return [("orb outline", RIM_RED, [orb]),
                ("orb", ORB_RED, [inner]),
                ("letters", WHITE, self.letters)]


def num(v):
    s = f"{v:.2f}".rstrip("0").rstrip(".")
    if s in ("-0", ""):
        s = "0"
    return s + ("f" if "." in s else "")


def to_icon(glyph, color):
    out = [f"// {GENERATED_NOTE}", "", f"CANVAS_DIMENSIONS, {glyph.canvas},"]
    for i, (name, rgb, items) in enumerate(glyph.layers(color)):
        if i:
            out.append("NEW_PATH,")
        out.append(f"// {name}")
        if rgb:
            out.append("PATH_COLOR_ARGB, 0xFF, " + ", ".join(f"0x{c:02X}" for c in rgb) + ",")
        for it in items:
            if it[0] == "circle":
                out.append(f"CIRCLE, {num(it[1])}, {num(it[2])}, {num(it[3])},")
                continue
            for op, *pts in it:
                args = ", ".join(num(v) for p in pts for v in p)
                out.append({"M": "MOVE_TO", "L": "LINE_TO", "C": "CUBIC_TO",
                            "Z": "CLOSE"}[op] + (", " + args if args else "") + ",")
    return "\n".join(out) + "\n"


def to_svg(glyph, color, current_color=False):
    parts = []
    for _, rgb, items in glyph.layers(color):
        d = []
        for it in items:
            if it[0] == "circle":
                _, cx, cy, r = it
                d.append(f"M{svgnum(cx - r)} {svgnum(cy)}a{svgnum(r)} {svgnum(r)} 0 1 0 {svgnum(2 * r)} 0"
                         f"a{svgnum(r)} {svgnum(r)} 0 1 0 {svgnum(-2 * r)} 0Z")
                continue
            for op, *pts in it:
                d.append(op + " ".join(f"{svgnum(x)} {svgnum(y)}" for x, y in pts))
        fill = "currentColor" if (current_color or not rgb) else "#%02X%02X%02X" % rgb
        parts.append(f'<path fill-rule="evenodd" fill="{fill}" d="{"".join(d)}"/>')
    c = glyph.canvas
    return (f'<svg width="{c}" height="{c}" viewBox="0 0 {c} {c}" fill="none" '
            f'xmlns="http://www.w3.org/2000/svg">' + "".join(parts) + "</svg>\n")


def svgnum(v):
    return num(v).rstrip("f")


# ----------------------------------------------------------------------------
# A small independent renderer for the .icon subset written above. It reads
# the generated text back, so the PNGs and previews show what Chromium will
# draw, and a malformed file fails here instead of in the browser build.

def flatten(p0, a, b, c, steps=24):
    pts = []
    for i in range(1, steps + 1):
        t = i / steps
        u = 1 - t
        pts.append((u ** 3 * p0[0] + 3 * u * u * t * a[0] + 3 * u * t * t * b[0] + t ** 3 * c[0],
                    u ** 3 * p0[1] + 3 * u * u * t * a[1] + 3 * u * t * t * b[1] + t ** 3 * c[1]))
    return pts


def parse_icon(text):
    tokens = []
    for line in text.splitlines():
        line = line.partition("//")[0].strip()
        tokens += [t.strip() for t in line.split(",") if t.strip()]
    arity = {"CANVAS_DIMENSIONS": 1, "NEW_PATH": 0, "PATH_COLOR_ARGB": 4,
             "MOVE_TO": 2, "LINE_TO": 2, "CUBIC_TO": 6, "CIRCLE": 3, "CLOSE": 0}
    canvas, paths, i = None, [{"color": None, "polys": []}], 0
    cur, start = None, None
    while i < len(tokens):
        cmd = tokens[i]
        if cmd not in arity:
            raise ValueError(f"unsupported or malformed command {cmd!r}")
        args = []
        for t in tokens[i + 1:i + 1 + arity[cmd]]:
            if t.startswith("0x"):
                args.append(int(t, 16))
            else:
                if t.endswith("f") != ("." in t):
                    raise ValueError(f"{cmd}: number {t!r} must end in f exactly when it has a point")
                args.append(float(t.rstrip("f")))
        if len(args) != arity[cmd]:
            raise ValueError(f"{cmd}: expected {arity[cmd]} arguments")
        i += 1 + arity[cmd]
        p = paths[-1]
        if cmd == "CANVAS_DIMENSIONS":
            canvas = args[0]
        elif cmd == "NEW_PATH":
            paths.append({"color": None, "polys": []})
        elif cmd == "PATH_COLOR_ARGB":
            p["color"] = tuple(args[1:]) + (args[0],)
        elif cmd == "MOVE_TO":
            cur = [tuple(args)]
            p["polys"].append(cur)
        elif cmd == "LINE_TO":
            cur.append(tuple(args))
        elif cmd == "CUBIC_TO":
            cur += flatten(cur[-1], args[0:2], args[2:4], args[4:6])
        elif cmd == "CIRCLE":
            cx, cy, r = args
            p["polys"].append([(cx + r * math.cos(k * math.tau / 96),
                                cy + r * math.sin(k * math.tau / 96))
                               for k in range(96)])
        elif cmd == "CLOSE":
            cur = None
    if canvas is None:
        raise ValueError("no CANVAS_DIMENSIONS")
    return canvas, paths


def render_icon(text, size, color=(0, 0, 0)):
    canvas, paths = parse_icon(text)
    ss = 8
    big = size * ss
    k = big / canvas
    img = Image.new("RGBA", (big, big), (0, 0, 0, 0))
    for p in paths:
        mask = Image.new("1", (big, big), 0)
        for poly in p["polys"]:
            m = Image.new("1", (big, big), 0)
            ImageDraw.Draw(m).polygon([(x * k, y * k) for x, y in poly], fill=1)
            mask = ImageChops.logical_xor(mask, m)  # even-odd
        rgba = p["color"] or tuple(color) + (255,)
        layer = Image.new("RGBA", (big, big), rgba)
        img.paste(layer, (0, 0), mask.convert("L"))
    return img.resize((size, size), Image.LANCZOS)


# ----------------------------------------------------------------------------

def master(name):
    return Image.open(os.path.join(MASTERS, f"beryllium-{name}.png")).convert("RGBA")


def square(img, size, padding=ICON_PADDING):
    """img centred on a transparent square of size x size."""
    inner = size * (1 - 2 * padding)
    scale = inner / max(img.size)
    w, h = max(1, round(img.width * scale)), max(1, round(img.height * scale))
    out = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    out.alpha_composite(img.resize((w, h), Image.LANCZOS), ((size - w) // 2, (size - h) // 2))
    return out


def app_icon(size):
    src = "orb" if size <= SMALL_ICON_MAX else "emblem"
    return square(master(src), size)


def emblem(size):
    return square(master("emblem"), size, padding=0)


def embedded_svg(size):
    """The colour emblem as a PNG inside an SVG of size x size."""
    import base64
    buf = io.BytesIO()
    emblem(size).save(buf, format="PNG", optimize=True)
    data = base64.b64encode(buf.getvalue()).decode()
    return (f'<svg width="{size}" height="{size}" viewBox="0 0 {size} {size}" '
            f'xmlns="http://www.w3.org/2000/svg"><image width="{size}" height="{size}" '
            f'href="data:image/png;base64,{data}"/></svg>\n')


def lockup(width, height, font_path, text_rgb):
    """Emblem + "Beryllium", fitted into exactly width x height."""
    img = Image.new("RGBA", (width, height), (0, 0, 0, 0))
    img.alpha_composite(emblem(height), (0, 0))
    gap = round(height * 0.18)
    avail = width - height - gap
    size = height
    while size > 4:
        font = ImageFont.truetype(font_path, size)
        x0, y0, x1, y1 = font.getbbox("Beryllium", anchor="ls")
        cap = -font.getbbox("B", anchor="ls")[1]
        if x1 - x0 <= avail and cap <= height * 0.5:
            break
        size -= 1
    d = ImageDraw.Draw(img)
    # Centre the capitals on the emblem.
    baseline = round(height * 0.5 + cap / 2)
    d.text((height + gap - x0, baseline), "Beryllium", font=font,
           fill=text_rgb + (255,), anchor="ls")
    return img


# Destinations, applied with Helium's utils/replace_resources.py after
# Helium's own list, so every Helium logo is replaced. Each one exists in
# Chromium 156.0.8078.79 or in the pinned onboarding archive (checked by hand
# on 2 November 2026); a typo would only add an unused file.
