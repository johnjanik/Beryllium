)


def resource_list():
    lines = ["# " + GENERATED_NOTE,
             "# Applied after Helium's helium_resources.txt, in the same format.", ""]
    lines += [f"{src} {dest}" for src, dest in RESOURCES]
    return "\n".join(lines) + "\n"


def save_png(img, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    img.save(path, optimize=True)


def generate(out, font_path, icons_out=ICONS):
    os.makedirs(out, exist_ok=True)
    g = Glyph(font_path)
    files = {}

    # Vector glyph.
    icons = {"product_logo.icon": to_icon(g, color=False),
             "product_logo_color.icon": to_icon(g, color=True)}
    for name, text in icons.items():
        files[name] = text.encode()
        render_icon(text, 32)  # parse check
    files["product_logo.svg"] = embedded_svg(256).encode()
    files["onboarding_logo.svg"] = embedded_svg(192).encode()

    pngs = {}
    pngs["product_logo_22_mono.png"] = render_icon(icons["product_logo.icon"], 22, MONO_GREY)
    for name, w, h, rgb in [
            ("product_logo.png", 140, 32, INK),
            ("product_logo_white.png", 140, 32, WHITE),
            ("product_logo_200.png", 280, 64, INK),
            ("product_logo_white_200.png", 280, 64, WHITE),
            ("product_logo_name_22.png", 97, 22, INK),
            ("product_logo_name_22_white.png", 97, 22, WHITE),
            ("product_logo_name_22_200.png", 194, 44, INK),
            ("product_logo_name_22_white_200.png", 194, 44, WHITE)]:
        pngs[name] = lockup(w, h, font_path, rgb)
    icons = {}
    for s in ICON_SIZES:
        icons[f"beryllium-{s}.png"] = app_icon(s)
    for name, img in pngs.items():
        buf = io.BytesIO()
        img.save(buf, format="PNG", optimize=True)
        files[name] = buf.getvalue()

    files["beryllium_resources.txt"] = resource_list().encode()
    for name, data in files.items():
        path = os.path.join(out, name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "wb") as f:
            f.write(data)
    os.makedirs(icons_out, exist_ok=True)
    for name, img in icons.items():
        img.save(os.path.join(icons_out, name), format="PNG", optimize=True)
    return g


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--font", default=next((f for f in FONT_CANDIDATES if os.path.exists(f)), None))
    ap.add_argument("--out", default=os.path.join(BRANDING, "chromium"))
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args(argv)
    if not a.font:
        sys.exit("make-chromium-branding: Inter Bold not found; pass --font")
    if not a.check:
        generate(a.out, a.font)
        print(f"make-chromium-branding: wrote {a.out} and {ICONS}")
        return 0
    with tempfile.TemporaryDirectory() as tmp:
        generate(os.path.join(tmp, "chromium"), a.font, os.path.join(tmp, "icons"))
        diffs = []

        def walk(c, prefix=""):
            diffs.extend(prefix + n for n in c.diff_files + c.left_only + c.right_only)
            for n, sub in c.subdirs.items():
                walk(sub, prefix + n + "/")
        walk(filecmp.dircmp(os.path.join(tmp, "chromium"), a.out), "chromium/")
        walk(filecmp.dircmp(os.path.join(tmp, "icons"), ICONS), "artwork/icons/")
        if diffs:
            print("make-chromium-branding: committed files differ: " + ", ".join(diffs))
            return 1
    print("make-chromium-branding: committed files match the generator")
    return 0


if __name__ == "__main__":
    sys.exit(main())
