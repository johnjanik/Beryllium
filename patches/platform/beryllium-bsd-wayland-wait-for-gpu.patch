 #include "base/functional/bind.h"
 #include "base/task/thread_pool.h"
 #include "base/trace_event/trace_event.h"
 #include "base/trace_event/typed_macros.h"
+#include "build/build_config.h"
 #include "ui/gfx/gpu_fence.h"
 #include "ui/gfx/gpu_fence_handle.h"
 #include "ui/gfx/swap_result.h"
@@ -33,6 +36,29 @@
 // and remove the rest.
 static constexpr size_t kMaxSolidColorBuffers = 12;
 
+#if BUILDFLAG(IS_FREEBSD)
+// Beryllium: FreeBSD builds have no GPU fence file descriptors
+// (gl_fence_android_native_fence_sync is not built on BSD), so when the
+// compositor offers no explicit-sync protocol a frame is committed right
+// after glFlush(), with nothing to wait for. Mesa drivers order the
+// compositor's reads after the rendering (implicit sync); NVIDIA's driver
+// does not, and the compositor shows frames that are still being drawn,
+// which flickers. Wait for the GPU before committing on NVIDIA.
+// --disable-features=BerylliumWaylandWaitForGpu turns this off.
+BASE_FEATURE(kBerylliumWaylandWaitForGpu, base::FEATURE_ENABLED_BY_DEFAULT);
+
+bool BerylliumWaitForGpuBeforeCommit() {
+  static const bool wait = [] {
+    if (!base::FeatureList::IsEnabled(kBerylliumWaylandWaitForGpu)) {
+      return false;
+    }
+    const char* vendor = reinterpret_cast<const char*>(glGetString(GL_VENDOR));
+    return vendor && std::strstr(vendor, "NVIDIA");
+  }();
+  return wait;
+}
+#endif
+
 void WaitForGpuFences(std::vector<std::unique_ptr<gfx::GpuFence>> fences) {
   for (auto& fence : fences)
     fence->Wait();
@@ -187,7 +213,15 @@
   }
 
   if (!no_gl_flush_for_tests_ && !buffer_manager_->supports_acquire_fence()) {
+#if BUILDFLAG(IS_FREEBSD)
+    if (use_egl_fence_sync_ && BerylliumWaitForGpuBeforeCommit()) {
+      glFinish();
+    } else {
+      glFlush();
+    }
+#else
     glFlush();
+#endif
   }
 
   PendingFrame* frame = unsubmitted_frames_.back().get();
