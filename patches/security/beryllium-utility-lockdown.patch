 BASE_FEATURE(kBerylliumInviteAfterLockdown, FEATURE_ENABLED_BY_DEFAULT);
 
+BASE_FEATURE(kBerylliumCapsicumUtilities, FEATURE_DISABLED_BY_DEFAULT);
+
+const char kBerylliumLockdownSwitch[] = "beryllium-lockdown";
+const char kBerylliumConfineServicesSwitch[] = "beryllium-confine-services";
+
+bool BrowserConfinesUtility(std::string_view sub_type) {
+  if (sub_type.empty() || !FeatureList::IsEnabled(kBerylliumCapsicumUtilities)) {
+    return false;
+  }
+  // Services that are given their input and hand back their output over
+  // Mojo, and that Chromium runs under its tightest policies elsewhere.
+  // Candidates: none of them has been surveyed after its start on FreeBSD,
+  // which is what the feature being off by default says.
+  static constexpr std::string_view kComputeOnly[] = {
+      "data_decoder.mojom.DataDecoderService",
+      "unzip.mojom.Unzipper",
+      "patch.mojom.FilePatcher",
+  };
+  for (std::string_view name : kComputeOnly) {
+    if (sub_type == name) {
+      return true;
+    }
+  }
+  const std::string more =
+      CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kBerylliumConfineServicesSwitch);
+  size_t begin = 0;
+  while (begin <= more.size()) {
+    size_t end = more.find(',', begin);
+    if (end == std::string::npos) {
+      end = more.size();
+    }
+    if (end > begin && sub_type == std::string_view(more).substr(begin, end - begin)) {
+      return true;
+    }
+    begin = end + 1;
+  }
+  return false;
+}
