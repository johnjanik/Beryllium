 constexpr char kLockdownMarker[] = "BERYLLIUM-LOCKDOWN";
 
+// Writes the marker, followed by what this process is: its type as on its
+// command line ("browser" for the browser process) and, for a utility, the
+// service it runs. The survey sorts processes by that, including those that
+// start and end too quickly for it to ask the browser about them, which is
+// most utilities. Before 0.20.3.22 the marker stood alone and only
+// renderers wrote it.
+void WriteLockdownMarker() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  std::string marker = kLockdownMarker;
+  const std::string type =
+      command_line.GetSwitchValueASCII(switches::kProcessType);
+  marker += " " + (type.empty() ? std::string("browser") : type);
+  const std::string service =
+      command_line.GetSwitchValueASCII("utility-sub-type");
+  if (!service.empty()) {
+    marker += " " + service;
+  }
+  utrace(marker.data(), marker.size());
+}
