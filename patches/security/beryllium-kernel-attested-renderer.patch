+// What the kernel says about a process's capability mode: the flag
+// KI_CRF_CAPABILITY_MODE of its kinfo_proc (kern.proc.pid), which procstat -s
+// prints as C. kUnknown when the kernel gives no answer: the process is
+// gone, or a jail or a MAC policy hides it. Nothing the process itself says
+// is used.
+enum class KernelAnswer { kYes, kNo, kUnknown };
+BASE_EXPORT KernelAnswer KernelSaysCapabilityMode(pid_t pid);
+
+// The browser's record of the check it makes when a confined peer's channel
+// connects (content/browser/renderer_host, plan/18 section 2): kYes is an
+// attested renderer; anything else is a renderer the browser ended. The
+// entry for a pid goes with ForgetConfinedPeer(); the totals are for the
+// session.
+BASE_EXPORT void RecordAttestation(pid_t pid, KernelAnswer answer);
+BASE_EXPORT bool WasAttested(pid_t pid);
+BASE_EXPORT int AttestedTotal();
+BASE_EXPORT int EndedUnattestedTotal();
