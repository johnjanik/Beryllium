+#if BUILDFLAG(IS_FREEBSD)
+namespace {
+
+// Beryllium (plan/18 section 2, stage A; feature matrix S-STA-01): a
+// renderer the browser launched with the lockdown on is in capability mode
+// by the time its channel connects, because RendererMain locks down before
+// RenderThreadImpl exists and so before the Mojo invitation is accepted.
+// The browser asks the kernel, and nothing the renderer says counts: the
+// pid is the one the launcher got from fork, not the one the channel
+// reports. A renderer that is not confined, or about which the kernel gives
+// no answer, is ended before it is announced as ready. This does not depend
+// on --no-sandbox: a renderer asked to lock down that did not is ended
+// whatever the reason. Returns false when the renderer was ended.
+bool BerylliumKernelAttestsRenderer(RenderProcessHost* host) {
+  const base::Process& process = host->GetProcess();
+  if (!process.IsValid() || process.is_current()) {
+    return true;
+  }
+  const base::ProcessId pid = process.Pid();
+  if (!base::freebsd::IsConfinedPeer(pid)) {
+    return true;  // not launched with the lockdown on
+  }
+  const base::freebsd::KernelAnswer answer =
+      base::freebsd::KernelSaysCapabilityMode(pid);
+  base::freebsd::RecordAttestation(pid, answer);
+  if (answer == base::freebsd::KernelAnswer::kYes) {
+    LOG(WARNING) << "beryllium-sandbox: renderer pid=" << pid
+                 << " attested: in capability mode by the kernel's account";
+    return true;
+  }
+  LOG(ERROR) << "beryllium-sandbox: renderer pid=" << pid
+             << (answer == base::freebsd::KernelAnswer::kNo
+                     ? " is not in capability mode by the kernel's account"
+                     : " has no answer from the kernel about its capability "
+                       "mode")
+             << "; ended";
+  host->Shutdown(RESULT_CODE_KILLED);
+  // Shutdown() asks with SIGTERM, which a process that is not doing what it
+  // was asked can ignore. The pid cannot have been reused: the browser is
+  // the parent and has not reaped it.
+  kill(pid, SIGKILL);
+  return false;
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_FREEBSD)
