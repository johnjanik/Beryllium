+KernelAnswer KernelSaysCapabilityMode(pid_t pid) {
+  int mib[] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, pid};
+  struct kinfo_proc kp;
+  size_t len = sizeof(kp);
+  if (sysctl(mib, 4, &kp, &len, nullptr, 0) != 0 || len != sizeof(kp) ||
+      static_cast<size_t>(kp.ki_structsize) != sizeof(kp) ||
+      kp.ki_pid != pid) {
+    return KernelAnswer::kUnknown;
+  }
+  return (kp.ki_cr_flags & KI_CRF_CAPABILITY_MODE) ? KernelAnswer::kYes
+                                                   : KernelAnswer::kNo;
+}
+
+void RecordAttestation(pid_t pid, KernelAnswer answer) {
+  AutoLock lock(Peers().lock);
+  if (answer == KernelAnswer::kYes) {
+    Peers().attested.insert(pid);
+    ++Peers().attested_total;
+  } else {
+    ++Peers().ended_total;
+  }
+}
+
+bool WasAttested(pid_t pid) {
+  AutoLock lock(Peers().lock);
+  return Peers().attested.count(pid) != 0;
+}
+
+int AttestedTotal() {
+  AutoLock lock(Peers().lock);
+  return Peers().attested_total;
+}
+
+int EndedUnattestedTotal() {
+  AutoLock lock(Peers().lock);
+  return Peers().ended_total;
+}
+
