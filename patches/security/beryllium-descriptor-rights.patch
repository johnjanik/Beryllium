+// Copyright 2026 Beryllium Browser contributors
+// SPDX-License-Identifier: GPL-3.0-only
+//
+// Beryllium: the Capsicum rights a confined process keeps on each kind of
+// descriptor (plan/06-SECURITY-MODEL.md section 3.2). Used by the renderer
+// lockdown (sandbox/policy/freebsd), by the message pump when it creates a
+// kqueue and an eventfd, and by Mojo when a confined process receives a
+// descriptor over a channel.
+
+#ifndef BASE_POSIX_CAPSICUM_RIGHTS_H_
+#define BASE_POSIX_CAPSICUM_RIGHTS_H_
+
+#include <optional>
+#include <string>
+
+#include "base/base_export.h"
+#include "base/files/scoped_file.h"
+
+struct kinfo_file;
+
+namespace base::freebsd {
+
+// The kinds of descriptor a confined process may hold, each with the rights
+// it needs and nothing more.
+enum class DescriptorKind {
+  kReadOnlyFile,   // read, seek, read-only mapping, fstat, F_GETFL
+  kSocket,         // send, receive, event, fstat, shutdown, get/setsockopt,
+                   // F_GETFL/F_SETFL; never connect, bind, listen or accept
+  kKqueue,         // kevent, event (epoll-shim polls it), fstat
+  kEvent,          // eventfd, pipe, fifo: read, write, event, fstat,
+                   // F_GETFL/F_SETFL, the ioctl FIONREAD
+  kSharedMemory,   // read, write, seek, mapping, fstat, F_GETFL; never
+                   // truncation, executable mapping or ownership changes
+  kDirectory,      // never kept: callers close it
+};
+
+// Cuts |fd| down to the rights, fcntl commands and ioctls of |kind| that it
+// has. Rights only ever shrink, so a descriptor its creator already limited
+// keeps the smaller set. Returns false with errno set; kDirectory is EINVAL.
+BASE_EXPORT bool LimitDescriptorRights(int fd, DescriptorKind kind);
+
+// Removes every right from |fd|: it stays open, so whoever expected it gets
+// a descriptor rather than an error, and every operation on it fails.
+BASE_EXPORT bool RemoveAllRights(int fd);
+
+// The kind of a descriptor from its kinfo_file entry (kern.proc.filedesc or
+// fcntl(F_KINFO); neither works in capability mode), or nullopt when the
+// policy has no kind for it (a writable or unnamed regular file, a device,
+// a terminal, a semaphore...). |description| says what it is, for logs.
+BASE_EXPORT std::optional<DescriptorKind> DescriptorKindFromKinfo(
+    const struct kinfo_file& kf,
+    std::string* description);
+
+// The kind of |fd| as far as a process in capability mode can tell: fstat,
+// then an empty kevent (only a kqueue answers) and F_GET_SEALS (only shared
+// memory answers), none of which needs a right. A regular file counts as
+// read-only only when it was opened read-only.
+BASE_EXPORT std::optional<DescriptorKind> DescriptorKindOf(
+    int fd,
+    std::string* description);
+
+// True once this process is in capability mode (a process never leaves it).
+BASE_EXPORT bool InCapabilityMode();
+
+// Called by the lockdown before it reads the descriptor table: from here on
+// every descriptor this process receives is limited as it arrives, so one
+// that arrives on another thread between the table snapshot and cap_enter()
+// (the IO thread is already receiving Mojo messages by then) does not keep
+// every right. Never reset.
+BASE_EXPORT void ExpectConfinement();
+
+// From ExpectConfinement() on, and in capability mode: limits a descriptor
+// this process has just received to its kind's rights, or removes every
+// right when the policy has no kind for it, logging what it was. Before
+// that it does nothing.
+BASE_EXPORT void LimitReceivedDescriptor(int fd);
+
+}  // namespace base::freebsd
+
+#endif  // BASE_POSIX_CAPSICUM_RIGHTS_H_
