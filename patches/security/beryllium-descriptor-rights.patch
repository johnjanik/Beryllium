+// Copyright 2026 Beryllium Browser contributors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "base/posix/capsicum_rights.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/capsicum.h>
+#include <sys/event.h>
+#include <sys/filio.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <sys/user.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <cstddef>
+
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace base::freebsd {
+
+namespace {
+
+constexpr uint32_t kGetFl = CAP_FCNTL_GETFL;
+constexpr uint32_t kGetSetFl = CAP_FCNTL_GETFL | CAP_FCNTL_SETFL;
+constexpr cap_ioctl_t kEventIoctls[] = {FIONREAD};
+
+// The policy, per kind: rights, fcntl commands, ioctls.
+bool PolicyFor(DescriptorKind kind,
+               cap_rights_t* rights,
+               uint32_t* fcntls,
+               const cap_ioctl_t** ioctls,
+               size_t* nioctls) {
+  *fcntls = 0;
+  *ioctls = nullptr;
+  *nioctls = 0;
+  switch (kind) {
+    case DescriptorKind::kReadOnlyFile:
+      cap_rights_init(rights, CAP_PREAD, CAP_MMAP_R, CAP_FSTAT, CAP_FCNTL);
+      *fcntls = kGetFl;
+      return true;
+    case DescriptorKind::kSocket:
+      cap_rights_init(rights, CAP_RECV, CAP_SEND, CAP_EVENT, CAP_FSTAT,
+                      CAP_FCNTL, CAP_SHUTDOWN, CAP_GETSOCKOPT, CAP_SETSOCKOPT);
+      *fcntls = kGetSetFl;
+      return true;
+    case DescriptorKind::kKqueue:
+      cap_rights_init(rights, CAP_KQUEUE, CAP_EVENT, CAP_FSTAT);
+      return true;
+    case DescriptorKind::kEvent:
+      cap_rights_init(rights, CAP_READ, CAP_WRITE, CAP_EVENT, CAP_FSTAT,
+                      CAP_FCNTL, CAP_IOCTL);
+      *fcntls = kGetSetFl;
+      *ioctls = kEventIoctls;
+      *nioctls = 1;
+      return true;
+    case DescriptorKind::kSharedMemory:
+      cap_rights_init(rights, CAP_READ, CAP_WRITE, CAP_SEEK, CAP_MMAP_RW,
+                      CAP_FSTAT, CAP_FCNTL);
+      *fcntls = kGetFl;
+      return true;
+    case DescriptorKind::kDirectory:
+      return false;
+  }
+  return false;
+}
+
+// A unix socket address with a path: a socket bound to one, or connected to
+// a service listening on one. The ends of a socketpair have none.
+const char* UnixPathOf(const struct sockaddr* sa, socklen_t len) {
+  if (sa == nullptr || len <= offsetof(struct sockaddr_un, sun_path) ||
+      sa->sa_family != AF_UNIX) {
+    return nullptr;
+  }
+  const char* path = reinterpret_cast<const struct sockaddr_un*>(sa)->sun_path;
+  return path[0] ? path : nullptr;
+}
+
+// The only sockets a confined process holds are Mojo's: the ends of unnamed
+// AF_UNIX socket pairs, stream (the channels) or seqpacket (the sandbox IPC
+// pair), connected to each other, never listening. A network socket, a
+// socket bound to a path or one connected to a named service (a display, a
+// daemon) carries authority capability mode does not take away: rights can
+// stop connect(), not a connection that exists.
+bool MojoSocketShape(int domain, int type, const struct sockaddr* local,
+                     socklen_t local_len, const struct sockaddr* peer,
+                     socklen_t peer_len, bool listening, std::string* why) {
+  if (domain != AF_UNIX) {
+    *why = "socket of domain " + NumberToString(domain);
+    return false;
+  }
+  if (type != SOCK_STREAM && type != SOCK_SEQPACKET) {
+    *why = "unix socket of type " + NumberToString(type);
+    return false;
+  }
+  if (listening) {
+    *why = "listening unix socket";
+    return false;
+  }
+  if (const char* path = UnixPathOf(local, local_len)) {
+    *why = std::string("unix socket bound to ") + path;
+    return false;
+  }
+  if (const char* path = UnixPathOf(peer, peer_len)) {
+    *why = std::string("unix socket connected to ") + path;
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+bool LimitDescriptorRights(int fd, DescriptorKind kind) {
+  cap_rights_t allowed;
+  uint32_t fcntls;
+  const cap_ioctl_t* ioctls;
+  size_t nioctls;
+  if (!PolicyFor(kind, &allowed, &fcntls, &ioctls, &nioctls)) {
+    errno = EINVAL;
+    return false;
+  }
+  cap_rights_t have;
+  if (cap_rights_get(fd, &have) != 0) {
+    return false;
+  }
+  cap_rights_t excess = have;
+  cap_rights_remove(&excess, &allowed);  // what it has beyond the policy
+  cap_rights_remove(&have, &excess);     // what it has within the policy
+  uint32_t have_fcntls = 0;
+  if (cap_fcntls_get(fd, &have_fcntls) != 0) {
+    return false;
+  }
+  return cap_rights_limit(fd, &have) == 0 &&
+         cap_fcntls_limit(fd, have_fcntls & fcntls) == 0 &&
+         cap_ioctls_limit(fd, ioctls, nioctls) == 0;
+}
+
+bool RemoveAllRights(int fd) {
+  cap_rights_t none;
+  cap_rights_init(&none);
+  return cap_rights_limit(fd, &none) == 0;
+}
+
+std::optional<DescriptorKind> DescriptorKindFromKinfo(
+    const struct kinfo_file& kf,
+    std::string* description) {
+  const std::string path =
+      kf.kf_path[0] ? std::string(" ") + kf.kf_path : std::string();
+  switch (kf.kf_type) {
+    case KF_TYPE_VNODE:
+      switch (kf.kf_vnode_type) {
+        case KF_VTYPE_VDIR:
+          *description = "directory" + path;
+          return DescriptorKind::kDirectory;
+        case KF_VTYPE_VREG:
+          if (kf.kf_flags & (KF_FLAG_WRITE | KF_FLAG_APPEND)) {
+            *description =
+                "writable file" + (path.empty() ? " with no name" : path);
+            return std::nullopt;
+          }
+          if (path.empty()) {
+            *description = "file with no name";
+            return std::nullopt;
+          }
+          *description = "read-only file" + path;
+          return DescriptorKind::kReadOnlyFile;
+        case KF_VTYPE_VCHR:
+        case KF_VTYPE_VBLK:
+          *description = "device" + path;
+          return std::nullopt;
+        default:
+          *description =
+              "vnode of type " + NumberToString(kf.kf_vnode_type) + path;
+          return std::nullopt;
+      }
+    case KF_TYPE_SOCKET: {
+      // kf_path holds the domain's name ("local"), not a path. A listening
+      // unix socket is bound to a path, which the address check catches.
+      std::string why;
+      if (!MojoSocketShape(
+              kf.kf_sock_domain, kf.kf_sock_type,
+              reinterpret_cast<const struct sockaddr*>(&kf.kf_sa_local),
+              sizeof(kf.kf_sa_local),
+              reinterpret_cast<const struct sockaddr*>(&kf.kf_sa_peer),
+              sizeof(kf.kf_sa_peer), /*listening=*/false, &why)) {
+        *description = why;
+        return std::nullopt;
+      }
+      *description = "socket";
+      return DescriptorKind::kSocket;
+    }
+    case KF_TYPE_PIPE:
+    case KF_TYPE_FIFO:
+      *description = "pipe";
+      return DescriptorKind::kEvent;
+    case KF_TYPE_EVENTFD:
+      *description = "eventfd";
+      return DescriptorKind::kEvent;
+    case KF_TYPE_KQUEUE:
+      *description = "kqueue";
+      return DescriptorKind::kKqueue;
+    case KF_TYPE_SHM:
+      *description = "shared memory";
+      return DescriptorKind::kSharedMemory;
+    case KF_TYPE_MQUEUE:
+      *description = "message queue";
+      return std::nullopt;
+    case KF_TYPE_SEM:
+      *description = "semaphore";
+      return std::nullopt;
+    case KF_TYPE_PTS:
+      *description = "terminal";
+      return std::nullopt;
+    case KF_TYPE_PROCDESC:
+      *description = "process descriptor";
+      return std::nullopt;
+    case KF_TYPE_DEV:
+      *description = "device" + path;
+      return std::nullopt;
+    default:
+      *description = "descriptor of type " + NumberToString(kf.kf_type);
+      return std::nullopt;
+  }
+}
+
+std::optional<DescriptorKind> DescriptorKindOf(int fd,
+                                               std::string* description) {
+  struct stat st;
+  if (fstat(fd, &st) != 0) {
+    *description = "descriptor fstat cannot describe";
+    return std::nullopt;
+  }
+  if (S_ISSOCK(st.st_mode)) {
+    int domain = -1, type = -1, listening = 0;
+    socklen_t len = sizeof(int);
+    getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &len);
+    len = sizeof(int);
+    getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &len);
+    len = sizeof(int);
+    getsockopt(fd, SOL_SOCKET, SO_ACCEPTCONN, &listening, &len);
+    struct sockaddr_un local = {}, peer = {};
+    socklen_t local_len = sizeof(local), peer_len = sizeof(peer);
+    if (getsockname(fd, reinterpret_cast<struct sockaddr*>(&local),
+                    &local_len) != 0) {
+      local_len = 0;
+    }
+    if (getpeername(fd, reinterpret_cast<struct sockaddr*>(&peer),
+                    &peer_len) != 0) {
+      peer_len = 0;  // not connected: it cannot connect without CAP_CONNECT
+    }
+    std::string why;
+    if (!MojoSocketShape(domain, type,
+                         reinterpret_cast<const struct sockaddr*>(&local),
+                         local_len,
+                         reinterpret_cast<const struct sockaddr*>(&peer),
+                         peer_len, listening != 0, &why)) {
+      *description = why;
+      return std::nullopt;
+    }
+    *description = "socket";
+    return DescriptorKind::kSocket;
+  }
+  if (S_ISFIFO(st.st_mode)) {
+    // Kqueues and eventfds report as fifos; only a kqueue accepts an empty
+    // kevent (which needs no right), anything else is EBADF.
+    const struct timespec now = {0, 0};
+    if (kevent(fd, nullptr, 0, nullptr, 0, &now) == 0) {
+      *description = "kqueue";
+      return DescriptorKind::kKqueue;
+    }
+    *description = "eventfd or pipe";
+    return DescriptorKind::kEvent;
+  }
+  if (S_ISREG(st.st_mode)) {
+    // Shared memory reports as a regular file; only it has seals.
+    if (fcntl(fd, F_GET_SEALS) >= 0) {
+      *description = "shared memory";
+      return DescriptorKind::kSharedMemory;
+    }
+    const int flags = fcntl(fd, F_GETFL);
+    if (flags >= 0 && (flags & O_ACCMODE) == O_RDONLY) {
+      *description = "read-only file";
+      return DescriptorKind::kReadOnlyFile;
+    }
+    *description = "writable file";
+    return std::nullopt;
+  }
+  if (S_ISDIR(st.st_mode)) {
+    *description = "directory";
+    return DescriptorKind::kDirectory;
+  }
+  if (S_ISCHR(st.st_mode) || S_ISBLK(st.st_mode)) {
+    *description = "device";
+    return std::nullopt;
+  }
+  *description = "descriptor of mode " + NumberToString(st.st_mode & S_IFMT);
+  return std::nullopt;
+}
+
+std::atomic<bool> g_confining{false};
+
+bool InCapabilityMode() {
+  static std::atomic<bool> known{false};
+  if (known.load(std::memory_order_relaxed)) {
+    return true;
+  }
+  u_int mode = 0;
+  if (cap_getmode(&mode) != 0 || mode == 0) {
+    return false;
+  }
+  known.store(true, std::memory_order_relaxed);
+  return true;
+}
+
+void ExpectConfinement() {
+  g_confining.store(true, std::memory_order_release);
+}
+
+void LimitReceivedDescriptor(int fd) {
+  if (!g_confining.load(std::memory_order_acquire) && !InCapabilityMode()) {
+    return;
+  }
+  std::string what;
+  const std::optional<DescriptorKind> kind = DescriptorKindOf(fd, &what);
+  if (kind && *kind != DescriptorKind::kDirectory) {
+    if (!LimitDescriptorRights(fd, *kind)) {
+      PLOG(ERROR) << "beryllium-sandbox: received " << what << " (fd " << fd
+                  << ") could not be limited";
+      RemoveAllRights(fd);
+    }
+    return;
+  }
+  LOG(ERROR) << "beryllium-sandbox: received " << what << " (fd " << fd
+             << "), which a confined process may not hold: every right removed";
+  RemoveAllRights(fd);
+}
+
+}  // namespace base::freebsd
