+// Beryllium (plan/18 section 3.2, P2): with kBerylliumCapsicumTrap the
+// kernel raises SIGTRAP (si_code TRAP_CAP) in a thread whose system call
+// capability mode has just refused. Until 0.20.3.21 nothing handled it, and
+// the renderer ended at its first refused call. From 0.20.3.22 the handler
+// below writes one line for the call, with the system call's number, the
+// error and the return addresses up the stack, and returns: the call then
+// fails as it would without the switch, and the renderer goes on. A run
+// with the switch therefore lists everything a confined renderer still
+// reaches for, each with the code that reached, and the test suite fails
+// on any line (freebsd/tests/browser, class TrapReport).
+//
+// The handler runs in whatever thread made the call, possibly inside a
+// library that holds a lock, so it uses no lock of its own: no logging, no
+// allocation, no dladdr(). The modules are listed once, before the
+// lockdown; a module loaded later shows as a bare address. The line goes to
+// stderr with write(2), where the rest of the lockdown's log goes.
+struct TrapModule {
+  uintptr_t base = 0;  // where the module is mapped; offsets are from here
+  uintptr_t end = 0;
+  char name[40] = {};
+};
+constexpr int kMaxTrapModules = 320;
+TrapModule g_trap_modules[kMaxTrapModules];
+int g_trap_module_count = 0;
+std::atomic<int> g_trap_reports{0};
+// A renderer that is refused the same call in a loop must not fill the log.
+constexpr int kMaxTrapReports = 200;
+struct sigaction g_previous_trap_action;
+
+int NoteTrapModule(struct dl_phdr_info* info, size_t, void* main_base) {
+  if (g_trap_module_count >= kMaxTrapModules) {
+    return 1;
+  }
+  uintptr_t begin = std::numeric_limits<uintptr_t>::max();
+  uintptr_t end = 0;
+  for (int i = 0; i < info->dlpi_phnum; ++i) {
+    const auto& ph = info->dlpi_phdr[i];
+    if (ph.p_type != PT_LOAD) {
+      continue;
+    }
+    const uintptr_t from = info->dlpi_addr + ph.p_vaddr;
+    begin = std::min(begin, from);
+    end = std::max(end, from + ph.p_memsz);
+  }
+  if (end == 0) {
+    return 0;
+  }
+  // The start of the page the first segment is mapped at is what dladdr()
+  // calls the module's base, and the socket pair lines give offsets from
+  // that; these lines do the same, so the suite names both the same way.
+  begin &= ~(static_cast<uintptr_t>(getpagesize()) - 1);
+  TrapModule& module = g_trap_modules[g_trap_module_count++];
+  module.base = begin;
+  module.end = end;
+  const char* name = info->dlpi_name;
+  if (reinterpret_cast<void*>(begin) == main_base || name == nullptr ||
+      name[0] == '\0') {
+    Dl_info self;
+    name = dladdr(reinterpret_cast<void*>(&NoteTrapModule), &self) != 0 &&
+                   self.dli_fname != nullptr
+               ? self.dli_fname
+               : "main";
+  }
+  const char* slash = strrchr(name, '/');
+  strlcpy(module.name, slash ? slash + 1 : name, sizeof(module.name));
+  return 0;
+}
+
+// Appends to |line| at |used|, never past |size|; both helpers are plain
+// loops so that the handler calls nothing that could take a lock.
+size_t TrapAppend(char* line, size_t size, size_t used, const char* text) {
+  while (*text != '\0' && used + 1 < size) {
+    line[used++] = *text++;
+  }
+  return used;
+}
+
+size_t TrapAppendNumber(char* line, size_t size, size_t used, uintptr_t value,
+                        int base) {
+  char digits[24];
+  int count = 0;
+  do {
+    const int digit = static_cast<int>(value % static_cast<uintptr_t>(base));
+    digits[count++] = static_cast<char>(digit < 10 ? '0' + digit
+                                                   : 'a' + digit - 10);
+    value /= static_cast<uintptr_t>(base);
+  } while (value != 0 && count < static_cast<int>(sizeof(digits)));
+  while (count > 0 && used + 1 < size) {
+    line[used++] = digits[--count];
+  }
+  return used;
+}
+
+size_t TrapAppendAddress(char* line, size_t size, size_t used,
+                         uintptr_t address) {
+  for (int i = 0; i < g_trap_module_count; ++i) {
+    const TrapModule& module = g_trap_modules[i];
+    if (address >= module.base && address < module.end) {
+      used = TrapAppend(line, size, used, module.name);
+      used = TrapAppend(line, size, used, "+0x");
+      return TrapAppendNumber(line, size, used, address - module.base, 16);
+    }
+  }
+  used = TrapAppend(line, size, used, "0x");
+  return TrapAppendNumber(line, size, used, address, 16);
+}
+
+void ReportRefusedCall(int signal_number, siginfo_t* info, void* context) {
+  if (info == nullptr || info->si_code != TRAP_CAP) {
+    // Any other trap (a failed CHECK ends in one) is not ours: hand it to
+    // whatever was installed before, or let it end the process.
+    if ((g_previous_trap_action.sa_flags & SA_SIGINFO) != 0 &&
+        g_previous_trap_action.sa_sigaction != nullptr) {
+      g_previous_trap_action.sa_sigaction(signal_number, info, context);
+      return;
+    }
+    if (g_previous_trap_action.sa_handler != SIG_DFL &&
+        g_previous_trap_action.sa_handler != SIG_IGN &&
+        g_previous_trap_action.sa_handler != nullptr) {
+      g_previous_trap_action.sa_handler(signal_number);
+      return;
+    }
+    signal(signal_number, SIG_DFL);
+    raise(signal_number);
+    return;
+  }
+  const int saved_errno = errno;
+  const int report = g_trap_reports.fetch_add(1, std::memory_order_relaxed);
+  if (report >= kMaxTrapReports) {
+    errno = saved_errno;
+    return;
+  }
+  char line[1400];
+  size_t used = 0;
+  used = TrapAppend(line, sizeof(line), used,
+                    "beryllium-sandbox: renderer pid=");
+  used = TrapAppendNumber(line, sizeof(line), used,
+                          static_cast<uintptr_t>(getpid()), 10);
+  used = TrapAppend(line, sizeof(line), used,
+                    " refused in capability mode: syscall=");
+  used = TrapAppendNumber(line, sizeof(line), used,
+                          static_cast<uintptr_t>(info->si_syscall), 10);
+  used = TrapAppend(line, sizeof(line), used, " errno=");
+  used = TrapAppendNumber(line, sizeof(line), used,
+                          static_cast<uintptr_t>(info->si_errno), 10);
+  used = TrapAppend(line, sizeof(line), used, " thread=");
+  used = TrapAppendNumber(line, sizeof(line), used,
+                          static_cast<uintptr_t>(pthread_getthreadid_np()), 10);
+  used = TrapAppend(line, sizeof(line), used, " frames:");
+  // Where the call was made, then the return addresses from the frame
+  // pointers this build keeps, as ReturnAddresses() in
+  // base/posix/capsicum_rights.cc reads them for the socket pair lines.
+  uintptr_t frame = 0;
+  uintptr_t stack = 0;
+  const auto* uc = static_cast<const ucontext_t*>(context);
+  if (uc != nullptr) {
+#if defined(__x86_64__)
+    used = TrapAppend(line, sizeof(line), used, " ");
+    used = TrapAppendAddress(line, sizeof(line), used,
+                             static_cast<uintptr_t>(uc->uc_mcontext.mc_rip));
+    frame = static_cast<uintptr_t>(uc->uc_mcontext.mc_rbp);
+    stack = static_cast<uintptr_t>(uc->uc_mcontext.mc_rsp);
+#elif defined(__aarch64__)
+    used = TrapAppend(line, sizeof(line), used, " ");
+    used = TrapAppendAddress(
+        line, sizeof(line), used,
+        static_cast<uintptr_t>(uc->uc_mcontext.mc_gpregs.gp_elr));
+    frame = static_cast<uintptr_t>(uc->uc_mcontext.mc_gpregs.gp_x[29]);
+    stack = static_cast<uintptr_t>(uc->uc_mcontext.mc_gpregs.gp_sp);
+#endif
+  }
+  // A frame pointer is followed only upwards from the interrupted stack
+  // pointer and within 8 MB of it, so a register that is not a frame
+  // pointer (libc's system call stubs keep none) ends the walk instead of
+  // being read through.
+  const uintptr_t limit = stack + (8u << 20);
+  for (int i = 0; i < 24; ++i) {
+    if (frame == 0 || frame % sizeof(uintptr_t) != 0 || frame < stack ||
+        frame >= limit) {
+      break;
+    }
+    const uintptr_t* words = reinterpret_cast<const uintptr_t*>(frame);
+    const uintptr_t next = words[0];
+    const uintptr_t ret = words[1];
+    if (ret == 0) {
+      break;
+    }
+    used = TrapAppend(line, sizeof(line), used, " ");
+    used = TrapAppendAddress(line, sizeof(line), used, ret);
+    if (next <= frame) {
+      break;
+    }
+    frame = next;
+  }
+  if (report + 1 == kMaxTrapReports) {
+    used = TrapAppend(line, sizeof(line), used,
+                      " (no further refused calls are reported)");
+  }
+  used = TrapAppend(line, sizeof(line), used, "\n");
+  std::ignore = HANDLE_EINTR(write(STDERR_FILENO, line, used));
+  errno = saved_errno;
+}
+
+// Lists the modules and installs the handler; before cap_enter(). False,
+// with errno set, if sigaction() failed.
+bool ReportRefusedCalls() {
+  Dl_info self;
+  void* main_base =
+      dladdr(reinterpret_cast<void*>(&NoteTrapModule), &self) != 0
+          ? self.dli_fbase
+          : nullptr;
+  g_trap_module_count = 0;
+  dl_iterate_phdr(&NoteTrapModule, main_base);
+  struct sigaction action = {};
+  action.sa_sigaction = &ReportRefusedCall;
+  action.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigemptyset(&action.sa_mask);
+  return sigaction(SIGTRAP, &action, &g_previous_trap_action) == 0;
+}
